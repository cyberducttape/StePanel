    systemd_lock
    cat > "/etc/systemd/system/$unit" <<EOF
[Unit]
Description=StePanel scheduled task $site/$name
After=stepanel-site-$site.slice
[Service]
Type=oneshot
User=$site_user
Group=$site_user
Slice=stepanel-site-$site.slice
WorkingDirectory=$root
