#!/usr/bin/env bash
set -Eeuo pipefail
if [[ $EUID -ne 0 ]]; then echo 'must run as root' >&2; exit 1; fi
action=${1:-}; site=${2:-}
[[ $site =~ ^[a-z0-9_-]{1,32}$ ]] || { echo 'invalid site' >&2; exit 1; }
command -v flock >/dev/null 2>&1 || { echo 'flock is required for application lifecycle locking' >&2; exit 1; }
install -d -o root -g root -m 0755 /run/lock/stepanel/app /run/lock/stepanel/account

# Serialize mutations for this site, while allowing unrelated sites to build
# dependencies and run lifecycle operations concurrently. Account slice
# updates use their own lock because the account name is not a site identity.
if [[ $action == account-resource-apply ]]; then
  lock_scope=account
else
  lock_scope=app
fi
case "$action" in
  # These are invoked from the task unit's ExecStartPre/ExecStopPost hooks.
  # They must not wait on the site lock while a task-delete/site-delete helper
  # holds that lock and synchronously asks systemd to stop the task unit.
  task-start|task-result|task-notify) ;;
  *) exec 9>"/run/lock/stepanel/$lock_scope/$site.lock"; flock -x 9 ;;
esac

# systemd's unit directory and manager reload are shared host state. Keep this
# lock around only atomic unit publication/removal plus daemon-reload, never
# around package installation or service start/restart operations.
systemd_lock() {
  exec 8>/run/lock/stepanel/systemd.lock
  flock -x 8
}
systemd_unlock() {
  flock -u 8
  exec 8>&-
}
validate_task_calendar_interval() {
  local calendar=$1 minimum=$2 rendered occurrence previous=0 current base
  base=$(date -u +%s) || return 1
  for ((i = 0; i < 32; i++)); do
    rendered=$(LC_ALL=C TZ=UTC systemd-analyze --base-time="@$base" calendar "$calendar") || return 1
    occurrence=$(sed -n -E 's/^[[:space:]]*Next elapse:[[:space:]]*(.*) UTC$/\1/p' <<< "$rendered")
    [[ -n $occurrence ]] || return 1
    current=$(date -u -d "$occurrence UTC" +%s) || return 1
    if (( previous > 0 && current - previous < minimum )); then return 1; fi
    previous=$current
    base=$((current + 1))
  done
}
valid_task_webhook() {
  local value=$1 host
  [[ -z $value ]] && return 0
  [[ $value == https://* && $value != *[[:space:]]* && $value != *"'"* && $value != *'"'* && $value != *\\* && $value != *$'\r'* && $value != *$'\n'* ]] || return 1
  host=${value#https://}; host=${host%%[/:?#]*}
  [[ $host == *.* && $host != .* && $host != *..* ]]
}
task_state_dir() { printf '/var/lib/stepanel/tasks/%s' "$1"; }
task_unit_name() { printf 'stepanel-task-%s-%s.service' "$1" "$2"; }
disable_task_timer() {
  local timer
  timer="stepanel-task-$1-$2.timer"
  systemctl stop "$timer" 2>/dev/null || true
  systemd_lock
  systemctl --no-reload disable "$timer" 2>/dev/null || true
  systemctl daemon-reload
  systemd_unlock
}
enable_units() {
  systemd_lock
  if ! systemctl --no-reload enable "$@" || ! systemctl daemon-reload; then
    systemd_unlock
    return 1
  fi
  systemd_unlock
}
disable_units() {
  systemd_lock
  if ! systemctl --no-reload disable "$@" || ! systemctl daemon-reload; then
    systemd_unlock
    return 1
  fi
  systemd_unlock
}

# Account operations use second parameter as account name, not site name
if [[ $action == account-resource-apply ]]; then
  (( $# == 8 )) || { echo 'usage: stepanel-appctl account-resource-apply ACCOUNT CPU_PERCENT CPU_WEIGHT MEMORY_HIGH_MB MEMORY_MAX_MB IO_WEIGHT TASKS_MAX' >&2; exit 64; }
  account=$2; cpu=$3; cpu_weight=$4; memory_high=$5; memory=$6; io_weight=$7; tasks=$8
  [[ $account =~ ^[a-z0-9_-]{1,32}$ && $cpu =~ ^[0-9]+$ && $cpu_weight =~ ^[0-9]+$ && $memory_high =~ ^[0-9]+$ && $memory =~ ^[0-9]+$ && $io_weight =~ ^[0-9]+$ && $tasks =~ ^[0-9]+$ ]] || { echo 'invalid account resource limits' >&2; exit 1; }
  (( cpu >= 25 && cpu <= 6400 && cpu_weight >= 1 && cpu_weight <= 10000 && memory_high >= 64 && memory_high <= memory && memory <= 1048576 && io_weight >= 1 && io_weight <= 10000 && tasks >= 16 && tasks <= 100000 )) || { echo 'account resource limits out of range' >&2; exit 1; }
  slice="/etc/systemd/system/stepanel-account-$account.slice"
  systemd_lock
  cat > "$slice" <<EOF
[Unit]
Description=StePanel aggregate resource boundary for $account
[Slice]
CPUQuota=${cpu}%
CPUWeight=$cpu_weight
MemoryHigh=${memory_high}M
MemoryMax=${memory}M
IOWeight=$io_weight
TasksMax=$tasks
EOF
  chmod 0644 "$slice"; chown root:root "$slice"; systemctl daemon-reload
  systemd_unlock
  systemctl start "stepanel-account-$account.slice"
  exit 0
fi

# All other actions require the persisted site user as argv[3]. Normalize it
# out of the legacy action argument positions after retaining it in the
# variable used to render every service and runuser invocation.
site_user=
if [[ $action != account-resource-apply ]]; then
  if [[ ${3:-} =~ ^sp-[a-z0-9][a-z0-9-]{1,28}$ ]]; then
    site_user=$3
    set -- "$1" "$2" "${@:4}"
  elif [[ ${STEPANEL_UNSAFE_LAB:-0} == 1 ]]; then
    hash=$(printf '%s' "$site" | sha256sum); hash=${hash%% *}
    prefix=${site:0:18}; prefix=${prefix//_/-}
    site_user="sp-${prefix}-${hash:0:8}"
  else
    echo 'persisted site Unix account is required' >&2
    exit 1
  fi
fi
unit="stepanel-app-${site}.service"
id "$site_user" >/dev/null 2>&1 || { echo 'isolated site user does not exist' >&2; exit 1; }
# Deletion still requires the persisted identity even though the account is
# not used to render units. This keeps the production broker and helper
# contract consistent and prevents an unscoped legacy delete invocation.
if [[ $action == delete ]]; then
  (( $# == 3 || (${STEPANEL_UNSAFE_LAB:-0} == 1 && $# == 2) )) || { echo 'usage: stepanel-appctl delete SITE SITE_USER' >&2; exit 64; }
  systemctl stop "stepanel-app-${site}.service" "stepanel-app-${site}-python.service" 2>/dev/null || true
  mapfile -t worker_units < <(systemctl list-unit-files --type=service --no-legend "stepanel-worker-$site-*.service" 2>/dev/null | awk '{print $1}')
  if (( ${#worker_units[@]} > 0 )); then systemctl stop "${worker_units[@]}" 2>/dev/null || true; fi
  mapfile -t task_timer_units < <(systemctl list-unit-files --type=timer --no-legend "stepanel-task-$site-*.timer" 2>/dev/null | awk '{print $1}')
  task_service_units=()
  for timer_unit in "${task_timer_units[@]}"; do task_service_units+=("${timer_unit%.timer}.service"); done
  if (( ${#task_timer_units[@]} > 0 )); then systemctl stop "${task_timer_units[@]}" "${task_service_units[@]}" 2>/dev/null || true; fi
  systemd_lock
  systemctl --no-reload disable "stepanel-app-${site}.service" "stepanel-app-${site}-python.service" 2>/dev/null || true
  if (( ${#worker_units[@]} > 0 )); then
    systemctl --no-reload disable "${worker_units[@]}" 2>/dev/null || true
  fi
  if (( ${#task_timer_units[@]} > 0 )); then
    systemctl --no-reload disable "${task_timer_units[@]}" 2>/dev/null || true
    for timer_unit in "${task_timer_units[@]}"; do rm -f "/etc/systemd/system/$timer_unit" "/etc/systemd/system/${timer_unit%.timer}.service"; done
  fi
  rm -f "/etc/systemd/system/stepanel-app-${site}.service" "/etc/systemd/system/stepanel-app-${site}-python.service"
  for unit in "${worker_units[@]}"; do rm -f "/etc/systemd/system/$unit"; done
  rm -rf "/var/lib/stepanel/tasks/$site"
  systemctl daemon-reload
  systemd_unlock
  exit 0
fi
case "$action" in
  apply)
    (( $# == 5 )) || { echo 'usage: stepanel-appctl apply SITE VERSION ROOT PORT' >&2; exit 64; }
    version=${3:?missing Node version}; root=${4:?missing root}; port=${5:?missing port}
    [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && $port =~ ^[0-9]+$ ]] || { echo 'invalid app parameters' >&2; exit 1; }
    (( port >= 1024 && port <= 65535 )) || { echo 'invalid app port' >&2; exit 1; }
    [[ $root == "/var/www/sites/$site/public" ]] || { echo 'invalid app root' >&2; exit 1; }
    path="/etc/systemd/system/$unit"
    staged=$(mktemp "/etc/systemd/system/.stepanel-app.XXXXXX")
    backup=$(mktemp)
    existed=0
    was_active=0
    if [[ -f $path ]]; then cp -p "$path" "$backup"; existed=1; fi
    if systemctl is-active --quiet "$unit"; then was_active=1; fi
    cleanup() { rm -f "$staged" "$backup"; }
    rollback() {
      systemd_lock
      if (( existed )); then
        mv -f "$backup" "$path"
      else
        rm -f "$path"
        systemctl --no-reload disable "$unit" || true
      fi
      systemctl daemon-reload || true
      systemd_unlock
      if (( existed && was_active )); then
        systemctl restart "$unit" || true
      else
        systemctl stop "$unit" || true
      fi
    }
    trap cleanup EXIT
    cat > "$staged" <<EOF
[Unit]
Description=StePanel Node app $site
After=network-online.target

[Service]
User=$site_user
Group=$site_user
Slice=stepanel-site-$site.slice
WorkingDirectory=$root
Environment=PORT=$port NODE_ENV=production HOME=/var/www/sites/$site
EnvironmentFile=-/etc/stepanel/environment/$site.env
ExecStart=/bin/bash -lc 'export NVM_DIR=/opt/stepanel/.nvm; . "\$NVM_DIR/nvm.sh"; nvm use $version >/dev/null; exec npm start'
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0027
LimitNOFILE=65536
TasksMax=256
ReadWritePaths=$root

[Install]
WantedBy=multi-user.target
EOF
    chmod 0644 "$staged"
    chown root:root "$staged"
    systemd_lock
    mv -f "$staged" "$path"
    if ! systemctl daemon-reload; then
      systemd_unlock
      rollback
      exit 1
    fi
    systemd_unlock
    # Distinguish first activation from configuration update
    if (( was_active )); then
      # Service was running: restart to apply new configuration
      if ! systemctl restart "$unit"; then
        rollback
        exit 1
      fi
    else
      # Service was not running: enable and start for the first time
      if ! enable_units "$unit" || ! systemctl start "$unit"; then
        rollback
        exit 1
      fi
    fi
    # Verify the service is active
    if ! systemctl is-active --quiet "$unit"; then
      rollback
      exit 1
    fi
    ;;
  worker-apply)
    (( $# == 8 )) || { echo 'usage: stepanel-appctl worker-apply SITE NAME TYPE ROOT PROCESSES MEMORY_MB RETRIES' >&2; exit 64; }
    name=$3; type=$4; root=$5; processes=$6; memory=$7; retries=${8:-0}
    [[ $name =~ ^[A-Za-z0-9_-]{1,32}$ && $type =~ ^(laravel|horizon|node|celery|rq)$ && $root == "/var/www/sites/$site/public" ]] || { echo 'invalid worker parameters' >&2; exit 1; }
    [[ $processes =~ ^[0-9]+$ && $memory =~ ^[0-9]+$ && $retries =~ ^[0-9]+$ ]] || { echo 'invalid worker limits' >&2; exit 1; }
    unit="stepanel-worker-${site}-${name}.service"; path="/etc/systemd/system/$unit"
    # The executable is deliberately a fixed, runtime-specific command. A
    # future build runner may provide artifacts, but this helper never accepts
    # arbitrary command text from the API.
    case "$type" in
      laravel) exec_start="/usr/bin/php $root/artisan queue:work --tries=$retries";;
      horizon) exec_start="/usr/bin/php $root/artisan horizon";;
      node) exec_start="/usr/bin/npm start";;
      celery) exec_start="/usr/bin/celery -A app worker --loglevel=INFO";;
      rq) exec_start="/usr/bin/rq worker";;
    esac
    # Track whether service was active before update
    was_active=0
    if systemctl is-active --quiet "$unit"; then was_active=1; fi
    staged=$(mktemp "/etc/systemd/system/.stepanel-worker.XXXXXX")
    cat > "$staged" <<EOF
[Unit]
Description=StePanel worker $site/$name
After=network-online.target
[Service]
User=$site_user
Group=$site_user
Slice=stepanel-site-$site.slice
WorkingDirectory=$root
ExecStart=$exec_start
Restart=on-failure
RestartSec=5s
MemoryMax=${memory}M
TasksMax=$((processes * 64))
NoNewPrivileges=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=$root
EnvironmentFile=-/etc/stepanel/environment/$site.env
UMask=0027
[Install]
WantedBy=multi-user.target
EOF
    chmod 0644 "$staged"; chown root:root "$staged"
    systemd_lock
    mv -f "$staged" "$path"
    systemctl daemon-reload
    systemd_unlock
    # Distinguish first creation from configuration update
    if (( was_active )); then
      systemctl restart "$unit" || exit 1
    else
      enable_units "$unit" || exit 1
      systemctl start "$unit" || exit 1
    fi
    # Verify the service is active
    systemctl is-active --quiet "$unit" || exit 1
    ;;
  worker-delete)
    (( $# == 3 )) || { echo 'usage: stepanel-appctl worker-delete SITE NAME' >&2; exit 64; }
    name=$3; [[ $name =~ ^[A-Za-z0-9_-]{1,32}$ ]] || { echo 'invalid worker name' >&2; exit 1; }
    unit="stepanel-worker-${site}-${name}.service"
    systemctl stop "$unit" 2>/dev/null || true
    systemd_lock
    systemctl --no-reload disable "$unit" 2>/dev/null || true
    rm -f "/etc/systemd/system/$unit"
    systemctl daemon-reload
    systemd_unlock ;;
  python-apply)
    (( $# == 7 )) || { echo 'usage: stepanel-appctl python-apply SITE VERSION ROOT ENTRYPOINT PORT WORKERS' >&2; exit 64; }
    version=$3; root=$4; entry=$5; port=$6; workers=$7
    [[ $version =~ ^3\.(12|13)$ && $root == "/var/www/sites/$site/public" && $entry =~ ^[A-Za-z0-9_./:-]{1,160}$ && $port =~ ^[0-9]+$ && $workers =~ ^[0-9]+$ ]] || { echo 'invalid Python parameters' >&2; exit 1; }
    (( port >= 1024 && port <= 65535 && workers >= 1 && workers <= 64 )) || { echo 'invalid Python limits' >&2; exit 1; }
    # The virtualenv lives beside, not inside, the document root: it is made of
    # symlinks, which the vhost helpers refuse to publish, and must not be served.
    unit="stepanel-app-${site}-python.service"; venv="/var/www/sites/$site/.venv"; legacy_venv="$root/.venv"; lockfile=/usr/local/share/stepanel/python/gunicorn-23.0.0.requirements.txt
    command -v "python$version" >/dev/null || { echo "python$version is not installed" >&2; exit 1; }
    [[ -f $lockfile && ! -L $lockfile ]] || { echo 'Python dependency lockfile is unavailable' >&2; exit 1; }
    venv_stage=; venv_backup=; venv_published=0
    cleanup_python_stage() { [[ -z ${venv_stage:-} ]] || rm -rf -- "$venv_stage"; }
    rollback_python_venv() {
      if (( venv_published )); then
        rm -rf -- "$venv"
        if [[ -n ${venv_backup:-} && -d $venv_backup ]]; then mv -f "$venv_backup" "$venv"; fi
      fi
    }
    # Build and verify a disposable environment first. A failed pip run never
    # mutates the environment used by an existing service.
    if [[ ! -x "$venv/bin/gunicorn" ]]; then
        venv_stage=$(mktemp -d "/var/www/sites/$site/.stepanel-venv.XXXXXX")
        "python$version" -m venv "$venv_stage" || { cleanup_python_stage; echo "python$version cannot create a virtualenv; on Debian/Ubuntu install python$version-venv" >&2; exit 1; }
        chown -R "$site_user:$site_user" "$venv_stage" || { cleanup_python_stage; exit 1; }
        if ! runuser -u "$site_user" -- env -i HOME="/var/www/sites/$site" PATH="/usr/local/bin:/usr/bin:/bin" LANG=C.UTF-8 "$venv_stage/bin/pip" install --quiet --require-hashes -r "$lockfile"; then
            echo 'gunicorn could not be installed in the site virtualenv' >&2
            cleanup_python_stage
            exit 1
        fi
        [[ -x "$venv_stage/bin/gunicorn" ]] || { cleanup_python_stage; echo 'gunicorn could not be installed in the site virtualenv' >&2; exit 1; }
        if [[ -e $venv ]]; then
            venv_backup=$(mktemp -d "/var/www/sites/$site/.stepanel-venv-old.XXXXXX")
            rmdir "$venv_backup"
            mv -f "$venv" "$venv_backup"
        fi
        mv -f "$venv_stage" "$venv"
        venv_stage=
        venv_published=1
    fi
    [[ -x "$venv/bin/gunicorn" ]] || { echo 'gunicorn could not be installed in the site virtualenv' >&2; exit 1; }
    # Track whether service was active before update
    was_active=0
    if systemctl is-active --quiet "$unit"; then was_active=1; fi
    unit_path="/etc/systemd/system/$unit"; unit_backup=$(mktemp); unit_existed=0
    if [[ -f $unit_path && ! -L $unit_path ]]; then cp -p "$unit_path" "$unit_backup"; unit_existed=1; fi
    rollback_python_deployment() {
      systemctl stop "$unit" 2>/dev/null || true
      rollback_python_venv
      systemd_lock
      if (( unit_existed )); then mv -f "$unit_backup" "$unit_path"; else rm -f "$unit_path"; systemctl --no-reload disable "$unit" 2>/dev/null || true; fi
      systemctl daemon-reload || true
      systemd_unlock
      if (( was_active )); then systemctl restart "$unit" 2>/dev/null || true; fi
    }
    staged=$(mktemp "/etc/systemd/system/.stepanel-python.XXXXXX")
    cat > "$staged" <<EOF
[Unit]
Description=StePanel Python app $site
After=network-online.target
[Service]
User=$site_user
Group=$site_user
Slice=stepanel-site-$site.slice
WorkingDirectory=$root
ExecStart=$venv/bin/python -m gunicorn --workers $workers --bind 127.0.0.1:$port $entry
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=$root
EnvironmentFile=-/etc/stepanel/environment/$site.env
MemoryMax=1G
TasksMax=256
UMask=0027
[Install]
WantedBy=multi-user.target
EOF
    chmod 0644 "$staged"; chown root:root "$staged"
    systemd_lock
    if ! mv -f "$staged" "$unit_path" || ! systemctl daemon-reload; then
      systemd_unlock
      rollback_python_deployment
      rm -f "$unit_backup"
      exit 1
    fi
    systemd_unlock
    # Distinguish first creation from configuration update
    if (( was_active )); then
      if ! systemctl restart "$unit"; then rollback_python_deployment; rm -f "$unit_backup"; exit 1; fi
    else
      if ! enable_units "$unit" || ! systemctl start "$unit"; then rollback_python_deployment; rm -f "$unit_backup"; exit 1; fi
    fi
    # Verify the service is active
    if ! systemctl is-active --quiet "$unit"; then rollback_python_deployment; rm -f "$unit_backup"; exit 1; fi
    rm -f "$unit_backup"
    [[ -z ${venv_backup:-} ]] || rm -rf -- "$venv_backup"
    if [[ -d $legacy_venv && ! -L $legacy_venv ]]; then rm -rf -- "$legacy_venv"; fi
    ;;
  node-tool)
    (( $# == 5 )) || { echo 'usage: stepanel-appctl node-tool SITE ACTION PACKAGE_MANAGER ROOT' >&2; exit 64; }
    action=$3; package_manager=$4; root=$5
    [[ $action =~ ^(install|build)$ && $package_manager =~ ^(npm|yarn|pnpm)$ && $root == "/var/www/sites/$site/public" ]] || { echo 'invalid Node tooling parameters' >&2; exit 1; }
    case "$action:$package_manager" in
      install:npm) command=(npm ci --no-audit --no-fund);;
      install:yarn) command=(yarn install --frozen-lockfile --non-interactive);;
      install:pnpm) command=(pnpm install --frozen-lockfile --ignore-scripts);;
      build:npm) command=(npm run build --if-present);;
      build:yarn) command=(yarn run build --if-present);;
      build:pnpm) command=(pnpm run build --if-present);;
    esac
    runuser -u "$site_user" -- sh -c 'cd "$1" && shift && exec env -i HOME="$1" NODE_ENV=production PATH="/usr/local/bin:/usr/bin:/bin" LANG=C.UTF-8 "$@"' sh "$root" "$root" "${command[@]}" ;;
  wp)
    # The root broker builds the arguments from a named operation; this
    # helper fixes the executable and WordPress path, refuses wp-cli global
    # options that load or reach other code, and runs as the site user so
    # site PHP never executes with root or panel privileges.
    (( $# >= 3 )) || { echo 'usage: stepanel-appctl wp SITE WP-CLI-ARGS...' >&2; exit 64; }
    shift 2
    site_root="/var/www/sites/$site"; root="$site_root/public"
    wp_cli=/usr/local/bin/wp
    [[ -x $wp_cli && ! -L $root && -d $root ]] || { echo 'wp-cli or the site public directory is unavailable' >&2; exit 1; }
    for arg in "$@"; do
      case "$arg" in
        --path*|--url*|--exec*|--require*|--ssh*|--http*|--user*|--allow-root*|--context*) echo "refusing wp-cli global option ${arg%%=*}" >&2; exit 1 ;;
      esac
      [[ $arg != *$'\n'* && $arg != *$'\r'* ]] || { echo 'invalid wp-cli argument' >&2; exit 1; }
    done
    exec runuser -u "$site_user" -- env -i HOME="$site_root" PATH="/usr/local/bin:/usr/bin:/bin" LANG=C.UTF-8 WP_CLI_CACHE_DIR="$site_root/.wp-cli/cache" WP_CLI_DISABLE_AUTO_CHECK_UPDATE=1 "$wp_cli" --path="$root" --no-color "$@" ;;
  composer-install)
    (( $# == 5 )) || { echo 'usage: stepanel-appctl composer-install SITE ROOT DEVELOPMENT OPTIMIZE' >&2; exit 64; }
    root=$3; development=$4; optimize=$5
    [[ $root == "/var/www/sites/$site/public" && $development =~ ^[01]$ && $optimize =~ ^[01]$ ]] || { echo 'invalid Composer parameters' >&2; exit 1; }
    command -v composer >/dev/null || { echo 'Composer is not installed' >&2; exit 1; }
    args=(install --no-interaction --no-progress --no-scripts --no-plugins)
    [[ $development == 1 ]] || args+=(--no-dev)
    [[ $optimize == 1 ]] && args+=(--optimize-autoloader)
    runuser -u "$site_user" -- sh -c 'cd "$1" && shift && exec env -i HOME="$1" COMPOSER_HOME="$1/.composer" PATH="/usr/local/bin:/usr/bin:/bin" LANG=C.UTF-8 composer "$@"' sh "$root" "$root" "${args[@]}" ;;
  resource-apply)
    (( $# == 8 || $# == 9 )) || { echo 'usage: stepanel-appctl resource-apply SITE CPU_PERCENT CPU_WEIGHT MEMORY_HIGH_MB MEMORY_MAX_MB IO_WEIGHT TASKS_MAX [ACCOUNT]' >&2; exit 64; }
    cpu=$3; cpu_weight=$4; memory_high=$5; memory=$6; io_weight=$7; tasks=$8; account=${9:-}
    [[ $cpu =~ ^[0-9]+$ && $cpu_weight =~ ^[0-9]+$ && $memory_high =~ ^[0-9]+$ && $memory =~ ^[0-9]+$ && $io_weight =~ ^[0-9]+$ && $tasks =~ ^[0-9]+$ ]] || { echo 'invalid resource limits' >&2; exit 1; }
    [[ -z $account || $account =~ ^[a-z0-9_-]{1,32}$ ]] || { echo 'invalid resource account' >&2; exit 1; }
    (( cpu >= 25 && cpu <= 6400 && cpu_weight >= 1 && cpu_weight <= 10000 && memory_high >= 64 && memory_high <= memory && memory <= 1048576 && io_weight >= 1 && io_weight <= 10000 && tasks >= 16 && tasks <= 100000 )) || { echo 'resource limits out of range' >&2; exit 1; }
    slice="/etc/systemd/system/stepanel-site-$site.slice"
    parent_slice=""
    [[ -z $account ]] || parent_slice="Slice=stepanel-account-$account.slice"
    systemd_lock
    cat > "$slice" <<EOF
[Unit]
Description=StePanel resource boundary for $site
[Slice]
$parent_slice
CPUQuota=${cpu}%
CPUWeight=$cpu_weight
MemoryHigh=${memory_high}M
MemoryMax=${memory}M
IOWeight=$io_weight
TasksMax=$tasks
EOF
    chmod 0644 "$slice"; chown root:root "$slice"; systemctl daemon-reload
    systemd_unlock
