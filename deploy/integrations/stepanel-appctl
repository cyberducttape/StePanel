# systemd may not execute files labelled var_lib_t (the task directory), but
# bash (bin_t) may read them.
ExecStart=/bin/bash $script
TimeoutStartSec=${timeout}s
TimeoutStopSec=7s
KillMode=control-group
CPUQuota=${task_cpu}%
MemoryMax=${task_memory}M
TasksMax=$task_tasks
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=$root
