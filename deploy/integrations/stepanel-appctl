      # task's environment: it stays in the root-only $notify_env, which the
      # privileged task-notify step reads after the task has stopped.
      cat >> "/etc/systemd/system/$unit" <<EOF
ExecStopPost=-+/usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin /usr/local/sbin/stepanel-appctl task-notify $site $site_user $name \${SERVICE_RESULT} \${EXIT_CODE} \${EXIT_STATUS}
EOF
    fi
    cat > "/etc/systemd/system/$timer" <<EOF
[Unit]
Description=StePanel scheduled task timer $site/$name
[Timer]
OnCalendar=$on_calendar
Persistent=$([[ $missed == run_once ]] && printf true || printf false)
Unit=$unit
[Install]
WantedBy=timers.target
EOF
    chmod 0644 "/etc/systemd/system/$unit" "/etc/systemd/system/$timer"; chown root:root "/etc/systemd/system/$unit" "/etc/systemd/system/$timer"
    mv -f "$staged" "$script"
    mv -f "$notify_staged" "$notify_env"
    systemctl daemon-reload
    systemd_unlock
    if [[ $enabled == 1 ]]; then
      enable_units "$timer"
      systemctl start "$timer"
    else
