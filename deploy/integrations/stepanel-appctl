  task-history)
    (( $# == 3 )) || { echo 'usage: stepanel-appctl task-history SITE NAME' >&2; exit 64; }
    name=$3; [[ $name =~ ^[A-Za-z0-9_-]{1,32}$ ]] || { echo 'invalid task name' >&2; exit 1; }
