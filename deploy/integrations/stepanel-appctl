      systemd_lock
      systemctl --no-reload disable "$timer" 2>/dev/null || true
      systemctl daemon-reload
      systemd_unlock
    fi ;;
  task-validate)
    (( $# == 4 )) || { echo 'usage: stepanel-appctl task-validate SITE ON_CALENDAR MIN_INTERVAL' >&2; exit 64; }
    minimum=$4
    if [[ ! $minimum =~ ^[0-9]+$ ]] || (( minimum < 60 || minimum > 31536000 )); then echo 'invalid task minimum interval' >&2; exit 1; fi
    validate_task_calendar_interval "$3" "$minimum" || { echo 'task calendar is invalid or runs more frequently than its minimum interval' >&2; exit 1; } ;;
  task-start)
    (( $# == 3 )) || { echo 'usage: stepanel-appctl task-start SITE NAME' >&2; exit 64; }
    name=$3; [[ $name =~ ^[A-Za-z0-9_-]{1,32}$ ]] || { echo 'invalid task name' >&2; exit 1; }
    task_root=$(task_state_dir "$site"); install -d -m 0755 -o root -g root "$task_root"
    printf '%s\n' "$(date +%s)" > "$task_root/$name.started"; chmod 0600 "$task_root/$name.started" ;;
  task-notify)
    # Runs as root from the task unit's ExecStopPost. The URL is read from the
    # root-only notification file and handed to the panel binary on stdin, as
    # the unprivileged panel user, so it never appears in an environment or
    # argv a tenant process can read. The panel binary enforces the outbound
    # policy (public destinations only, no redirects) at send time.
    (( $# == 6 )) || { echo 'usage: stepanel-appctl task-notify SITE NAME RESULT EXIT_CODE EXIT_STATUS' >&2; exit 64; }
    name=$3; result=$4; exit_code=$5; exit_status=$6
    [[ $name =~ ^[A-Za-z0-9_-]{1,32}$ && $result =~ ^[A-Za-z0-9_-]{1,32}$ && $exit_code =~ ^[A-Za-z0-9_-]{1,32}$ && $exit_status =~ ^[A-Za-z0-9_-]{1,32}$ ]] || { echo 'invalid task result' >&2; exit 1; }
    notify_env="$(task_state_dir "$site")/$name.env"
    [[ -f $notify_env && ! -L $notify_env ]] || exit 0
    webhook=$(sed -n 's/^STEPANEL_TASK_WEBHOOK_URL=//p' "$notify_env" | head -n 1)
    [[ -n $webhook ]] || exit 0
    valid_task_webhook "$webhook" || { echo 'stored notification webhook is invalid' >&2; exit 1; }
    printf '%s\n' "$webhook" | runuser -u stepanel -- env -i /opt/stepanel/stepanel task-webhook - "$site" "$name" "$result" "$exit_code" "$exit_status" ;;
  task-result)
    (( $# == 6 )) || { echo 'usage: stepanel-appctl task-result SITE NAME RESULT EXIT_CODE EXIT_STATUS' >&2; exit 64; }
    name=$3; result=$4; exit_code=$5; exit_status=$6
    [[ $name =~ ^[A-Za-z0-9_-]{1,32}$ && $result =~ ^[A-Za-z0-9_-]{1,32}$ && $exit_code =~ ^[A-Za-z0-9_-]{1,32}$ && $exit_status =~ ^[A-Za-z0-9_-]{1,32}$ ]] || { echo 'invalid task result' >&2; exit 1; }
    task_root=$(task_state_dir "$site"); history="$task_root/$name.history.tsv"; start=0
    [[ ! -f $task_root/$name.started ]] || read -r start < "$task_root/$name.started"
    [[ $start =~ ^[0-9]+$ ]] || start=$(date +%s)
    now=$(date +%s); duration=$((now - start)); (( duration >= 0 )) || duration=0
