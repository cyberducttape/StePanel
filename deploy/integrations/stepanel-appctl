    systemctl --no-reload disable "$timer" 2>/dev/null || true
    rm -f "/etc/systemd/system/$unit" "/etc/systemd/system/$timer" "/var/lib/stepanel/tasks/$site/$name.sh" "/var/lib/stepanel/tasks/$site/$name.env" "/var/lib/stepanel/tasks/$site/$name.history.tsv" "/var/lib/stepanel/tasks/$site/$name.started" "/var/lib/stepanel/tasks/$site/$name.auto-disabled" "/var/lib/stepanel/tasks/$site/.$name.history.lock" "/var/www/sites/$site/.stepanel-tasks/$name.sh"
