# and the AWS IPv6 endpoint), which can hand out host credentials. Loopback
# and private ranges stay reachable for local databases and caches.
IPAddressDeny=169.254.0.0/16 fd00:ec2::254/128
RuntimeDirectory=stepanel-task-$site-$name
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStartPre=+/usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin /usr/local/sbin/stepanel-appctl task-start $site $site_user $name
ExecStopPost=+/usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin /usr/local/sbin/stepanel-appctl task-result $site $site_user $name \${SERVICE_RESULT} \${EXIT_CODE} \${EXIT_STATUS}
EnvironmentFile=-/etc/stepanel/environment/$site.env
UMask=0027
EOF
    if [[ -n $webhook ]]; then
