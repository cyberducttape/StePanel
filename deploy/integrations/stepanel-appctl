#!/usr/bin/env bash
set -Eeuo pipefail
if [[ $EUID -ne 0 ]]; then echo 'must run as root' >&2; exit 1; fi
action=${1:-}; site=${2:-}
[[ $site =~ ^[a-z0-9_-]{1,32}$ ]] || { echo 'invalid site' >&2; exit 1; }
command -v flock >/dev/null 2>&1 || { echo 'flock is required for application lifecycle locking' >&2; exit 1; }
exec 9>/run/lock/stepanel-app.lock
flock -x 9

# Dispatch actions that don't require site-user validation first
if [[ $action == delete ]]; then
  (( $# == 2 )) || { echo 'usage: stepanel-appctl delete SITE' >&2; exit 64; }
  systemctl disable --now "stepanel-app-${site}.service" "stepanel-app-${site}-python.service" 2>/dev/null || true
  rm -f "/etc/systemd/system/stepanel-app-${site}.service" "/etc/systemd/system/stepanel-app-${site}-python.service"
  mapfile -t worker_units < <(systemctl list-unit-files --type=service --no-legend "stepanel-worker-$site-*.service" 2>/dev/null | awk '{print $1}')
  if (( ${#worker_units[@]} > 0 )); then systemctl disable --now "${worker_units[@]}" 2>/dev/null || true; fi
  for unit in "${worker_units[@]}"; do rm -f "/etc/systemd/system/$unit"; done
  systemctl daemon-reload
  exit 0
fi

# Account operations use second parameter as account name, not site name
if [[ $action == account-resource-apply ]]; then
  (( $# == 8 )) || { echo 'usage: stepanel-appctl account-resource-apply ACCOUNT CPU_PERCENT CPU_WEIGHT MEMORY_HIGH_MB MEMORY_MAX_MB IO_WEIGHT TASKS_MAX' >&2; exit 64; }
  account=$2; cpu=$3; cpu_weight=$4; memory_high=$5; memory=$6; io_weight=$7; tasks=$8
  [[ $account =~ ^[a-z0-9_-]{1,32}$ && $cpu =~ ^[0-9]+$ && $cpu_weight =~ ^[0-9]+$ && $memory_high =~ ^[0-9]+$ && $memory =~ ^[0-9]+$ && $io_weight =~ ^[0-9]+$ && $tasks =~ ^[0-9]+$ ]] || { echo 'invalid account resource limits' >&2; exit 1; }
  (( cpu >= 25 && cpu <= 6400 && cpu_weight >= 1 && cpu_weight <= 10000 && memory_high >= 64 && memory_high <= memory && memory <= 1048576 && io_weight >= 1 && io_weight <= 10000 && tasks >= 16 && tasks <= 100000 )) || { echo 'account resource limits out of range' >&2; exit 1; }
  slice="/etc/systemd/system/stepanel-account-$account.slice"
  cat > "$slice" <<EOF
[Unit]
Description=StePanel aggregate resource boundary for $account
[Slice]
CPUQuota=${cpu}%
CPUWeight=$cpu_weight
MemoryHigh=${memory_high}M
MemoryMax=${memory}M
IOWeight=$io_weight
TasksMax=$tasks
EOF
  chmod 0644 "$slice"; chown root:root "$slice"; systemctl daemon-reload; systemctl start "stepanel-account-$account.slice"
  exit 0
fi

# All other actions require a valid site user
unit="stepanel-app-${site}.service"
hash=$(printf '%s' "$site" | sha256sum); hash=${hash%% *}
prefix=${site:0:18}; prefix=${prefix//_/-}
site_user="sp-${prefix}-${hash:0:8}"
id "$site_user" >/dev/null 2>&1 || { echo 'isolated site user does not exist' >&2; exit 1; }
case "$action" in
  apply)
    (( $# == 5 )) || { echo 'usage: stepanel-appctl apply SITE VERSION ROOT PORT' >&2; exit 64; }
    version=${3:?missing Node version}; root=${4:?missing root}; port=${5:?missing port}
    [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && $port =~ ^[0-9]+$ ]] || { echo 'invalid app parameters' >&2; exit 1; }
    (( port >= 1024 && port <= 65535 )) || { echo 'invalid app port' >&2; exit 1; }
    [[ $root == "/var/www/sites/$site/public" ]] || { echo 'invalid app root' >&2; exit 1; }
    path="/etc/systemd/system/$unit"
    staged=$(mktemp "/etc/systemd/system/.stepanel-app.XXXXXX")
    backup=$(mktemp)
    existed=0
    was_active=0
    if [[ -f $path ]]; then cp -p "$path" "$backup"; existed=1; fi
    if systemctl is-active --quiet "$unit"; then was_active=1; fi
    cleanup() { rm -f "$staged" "$backup"; }
    rollback() {
      if (( existed )); then mv -f "$backup" "$path"; else rm -f "$path"; fi
      systemctl daemon-reload || true
      if (( existed && was_active )); then
        systemctl restart "$unit" || true
      else
        systemctl stop "$unit" || true
      fi
      if (( ! existed )); then systemctl disable "$unit" || true; fi
    }
    trap cleanup EXIT
    cat > "$staged" <<EOF
[Unit]
Description=StePanel Node app $site
After=network-online.target

[Service]
User=$site_user
Group=$site_user
Slice=stepanel-site-$site.slice
WorkingDirectory=$root
Environment=PORT=$port NODE_ENV=production HOME=/var/www/sites/$site
EnvironmentFile=-/etc/stepanel/environment/$site.env
ExecStart=/bin/bash -lc 'export NVM_DIR=/opt/stepanel/.nvm; . "\$NVM_DIR/nvm.sh"; nvm use $version >/dev/null; exec npm start'
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0027
LimitNOFILE=65536
TasksMax=256
ReadWritePaths=$root

[Install]
WantedBy=multi-user.target
EOF
    chmod 0644 "$staged"
    chown root:root "$staged"
    mv -f "$staged" "$path"
    if ! systemctl daemon-reload; then
      rollback
      exit 1
    fi
    # Distinguish first activation from configuration update
    if (( was_active )); then
      # Service was running: restart to apply new configuration
      if ! systemctl restart "$unit"; then
        rollback
        exit 1
      fi
    else
      # Service was not running: enable and start for the first time
      if ! systemctl enable --now "$unit"; then
        rollback
        exit 1
      fi
    fi
    # Verify the service is active
    if ! systemctl is-active --quiet "$unit"; then
      rollback
      exit 1
    fi
    ;;
  worker-apply)
    (( $# == 8 )) || { echo 'usage: stepanel-appctl worker-apply SITE NAME TYPE ROOT PROCESSES MEMORY_MB RETRIES' >&2; exit 64; }
    name=$3; type=$4; root=$5; processes=$6; memory=$7; retries=${8:-0}
    [[ $name =~ ^[A-Za-z0-9_-]{1,32}$ && $type =~ ^(laravel|horizon|node|celery|rq)$ && $root == "/var/www/sites/$site/public" ]] || { echo 'invalid worker parameters' >&2; exit 1; }
    [[ $processes =~ ^[0-9]+$ && $memory =~ ^[0-9]+$ && $retries =~ ^[0-9]+$ ]] || { echo 'invalid worker limits' >&2; exit 1; }
    unit="stepanel-worker-${site}-${name}.service"; path="/etc/systemd/system/$unit"
    # The executable is deliberately a fixed, runtime-specific command. A
    # future build runner may provide artifacts, but this helper never accepts
    # arbitrary command text from the API.
    case "$type" in
      laravel) exec_start="/usr/bin/php $root/artisan queue:work --tries=$retries";;
      horizon) exec_start="/usr/bin/php $root/artisan horizon";;
      node) exec_start="/usr/bin/npm start";;
      celery) exec_start="/usr/bin/celery -A app worker --loglevel=INFO";;
      rq) exec_start="/usr/bin/rq worker";;
    esac
    # Track whether service was active before update
    was_active=0
    if systemctl is-active --quiet "$unit"; then was_active=1; fi
    cat > "$path" <<EOF
[Unit]
Description=StePanel worker $site/$name
After=network-online.target
[Service]
User=$site_user
Group=$site_user
Slice=stepanel-site-$site.slice
WorkingDirectory=$root
ExecStart=$exec_start
Restart=on-failure
RestartSec=5s
MemoryMax=${memory}M
TasksMax=$((processes * 64))
NoNewPrivileges=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=$root
EnvironmentFile=-/etc/stepanel/environment/$site.env
UMask=0027
[Install]
WantedBy=multi-user.target
EOF
    chmod 0644 "$path"; chown root:root "$path"; systemctl daemon-reload
    # Distinguish first creation from configuration update
    if (( was_active )); then
      systemctl restart "$unit" || exit 1
    else
      systemctl enable --now "$unit" || exit 1
    fi
    # Verify the service is active
    systemctl is-active --quiet "$unit" || exit 1
    ;;
  worker-delete)
    (( $# == 3 )) || { echo 'usage: stepanel-appctl worker-delete SITE NAME' >&2; exit 64; }
    name=$3; [[ $name =~ ^[A-Za-z0-9_-]{1,32}$ ]] || { echo 'invalid worker name' >&2; exit 1; }
    unit="stepanel-worker-${site}-${name}.service"; systemctl disable --now "$unit" 2>/dev/null || true; rm -f "/etc/systemd/system/$unit"; systemctl daemon-reload ;;
  python-apply)
    (( $# == 7 )) || { echo 'usage: stepanel-appctl python-apply SITE VERSION ROOT ENTRYPOINT PORT WORKERS' >&2; exit 64; }
    version=$3; root=$4; entry=$5; port=$6; workers=$7
    [[ $version =~ ^3\.(12|13)$ && $root == "/var/www/sites/$site/public" && $entry =~ ^[A-Za-z0-9_./:-]{1,160}$ && $port =~ ^[0-9]+$ && $workers =~ ^[0-9]+$ ]] || { echo 'invalid Python parameters' >&2; exit 1; }
    (( port >= 1024 && port <= 65535 && workers >= 1 && workers <= 64 )) || { echo 'invalid Python limits' >&2; exit 1; }
    unit="stepanel-app-${site}-python.service"; venv="$root/.venv"; command -v "python$version" >/dev/null || { echo "python$version is not installed" >&2; exit 1; }
    "python$version" -m venv "$venv"
    # Transfer venv ownership to $site_user immediately (before any package operations)
    chown -R "$site_user:$site_user" "$venv"
    # Install Gunicorn as $site_user with pinned version and hash verification
    if [[ ! -x "$venv/bin/gunicorn" ]]; then
        # Create requirements file with hash for secure installation
        tmp_req=$(mktemp "$venv/.requirements.XXXXXX")
        cat > "$tmp_req" <<'REQS'
gunicorn==23.0.0 --hash=sha256:73909ceba925b5c0f634a5b224ff0a3e42d143f0c8b5ef12f2e548dbe9213395
REQS
        # Install with hash verification enabled
        runuser -u "$site_user" -- "$venv/bin/pip" install --quiet --require-hashes -r "$tmp_req" || {
            echo 'gunicorn could not be installed in the site virtualenv' >&2
            rm -f "$tmp_req"
            exit 1
        }
        rm -f "$tmp_req"
    fi
    [[ -x "$venv/bin/gunicorn" ]] || { echo 'gunicorn could not be installed in the site virtualenv' >&2; exit 1; }
    # Track whether service was active before update
    was_active=0
    if systemctl is-active --quiet "$unit"; then was_active=1; fi
    cat > "/etc/systemd/system/$unit" <<EOF
[Unit]
Description=StePanel Python app $site
After=network-online.target
[Service]
User=$site_user
Group=$site_user
Slice=stepanel-site-$site.slice
WorkingDirectory=$root
ExecStart=$venv/bin/gunicorn --workers $workers --bind 127.0.0.1:$port $entry
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=$root
EnvironmentFile=-/etc/stepanel/environment/$site.env
MemoryMax=1G
TasksMax=256
UMask=0027
[Install]
WantedBy=multi-user.target
EOF
    chmod 0644 "/etc/systemd/system/$unit"; systemctl daemon-reload
    # Distinguish first creation from configuration update
    if (( was_active )); then
      systemctl restart "$unit" || exit 1
    else
      systemctl enable --now "$unit" || exit 1
    fi
    # Verify the service is active
    systemctl is-active --quiet "$unit" || exit 1
    ;;
  node-tool)
    (( $# == 5 )) || { echo 'usage: stepanel-appctl node-tool SITE ACTION PACKAGE_MANAGER ROOT' >&2; exit 64; }
    action=$3; package_manager=$4; root=$5
    [[ $action =~ ^(install|build)$ && $package_manager =~ ^(npm|yarn|pnpm)$ && $root == "/var/www/sites/$site/public" ]] || { echo 'invalid Node tooling parameters' >&2; exit 1; }
    case "$action:$package_manager" in
      install:npm) command=(npm ci --no-audit --no-fund);;
      install:yarn) command=(yarn install --frozen-lockfile --non-interactive);;
      install:pnpm) command=(pnpm install --frozen-lockfile --ignore-scripts);;
      build:npm) command=(npm run build --if-present);;
      build:yarn) command=(yarn run build --if-present);;
      build:pnpm) command=(pnpm run build --if-present);;
    esac
    runuser -u "$site_user" -- sh -c "cd '$root' && env HOME='$root' NODE_ENV=production PATH='/usr/local/bin:/usr/bin:/bin' '${command[@]}'" ;;
  composer-install)
    (( $# == 5 )) || { echo 'usage: stepanel-appctl composer-install SITE ROOT DEVELOPMENT OPTIMIZE' >&2; exit 64; }
    root=$3; development=$4; optimize=$5
    [[ $root == "/var/www/sites/$site/public" && $development =~ ^[01]$ && $optimize =~ ^[01]$ ]] || { echo 'invalid Composer parameters' >&2; exit 1; }
    command -v composer >/dev/null || { echo 'Composer is not installed' >&2; exit 1; }
    args=(install --no-interaction --no-progress --no-scripts --no-plugins)
    [[ $development == 1 ]] || args+=(--no-dev)
    [[ $optimize == 1 ]] && args+=(--optimize-autoloader)
    runuser -u "$site_user" -- sh -c "cd '$root' && env HOME='$root' COMPOSER_HOME='$root/.composer' PATH='/usr/local/bin:/usr/bin:/bin' composer '${args[@]}'" ;;
  resource-apply)
    (( $# == 8 || $# == 9 )) || { echo 'usage: stepanel-appctl resource-apply SITE CPU_PERCENT CPU_WEIGHT MEMORY_HIGH_MB MEMORY_MAX_MB IO_WEIGHT TASKS_MAX [ACCOUNT]' >&2; exit 64; }
    cpu=$3; cpu_weight=$4; memory_high=$5; memory=$6; io_weight=$7; tasks=$8; account=${9:-}
    [[ $cpu =~ ^[0-9]+$ && $cpu_weight =~ ^[0-9]+$ && $memory_high =~ ^[0-9]+$ && $memory =~ ^[0-9]+$ && $io_weight =~ ^[0-9]+$ && $tasks =~ ^[0-9]+$ ]] || { echo 'invalid resource limits' >&2; exit 1; }
    [[ -z $account || $account =~ ^[a-z0-9_-]{1,32}$ ]] || { echo 'invalid resource account' >&2; exit 1; }
    (( cpu >= 25 && cpu <= 6400 && cpu_weight >= 1 && cpu_weight <= 10000 && memory_high >= 64 && memory_high <= memory && memory <= 1048576 && io_weight >= 1 && io_weight <= 10000 && tasks >= 16 && tasks <= 100000 )) || { echo 'resource limits out of range' >&2; exit 1; }
    slice="/etc/systemd/system/stepanel-site-$site.slice"
    parent_slice=""
    [[ -z $account ]] || parent_slice="Slice=stepanel-account-$account.slice"
    cat > "$slice" <<EOF
[Unit]
Description=StePanel resource boundary for $site
[Slice]
$parent_slice
CPUQuota=${cpu}%
CPUWeight=$cpu_weight
MemoryHigh=${memory_high}M
MemoryMax=${memory}M
IOWeight=$io_weight
TasksMax=$tasks
EOF
    chmod 0644 "$slice"; chown root:root "$slice"; systemctl daemon-reload; systemctl start "stepanel-site-$site.slice" ;;
  resource-status)
    (( $# == 2 )) || { echo 'usage: stepanel-appctl resource-status SITE' >&2; exit 64; }
    systemctl show "stepanel-site-$site.slice" --property=ActiveState --property=CPUQuotaPerSecUSec --property=CPUWeight --property=MemoryHigh --property=MemoryMax --property=MemoryCurrent --property=IOWeight --property=TasksMax --property=TasksCurrent --property=CPUUsageNSec --no-pager ;;
  task-apply)
    (( $# == 8 || $# == 11 )) || { echo 'usage: stepanel-appctl task-apply SITE NAME RUNTIME ON_CALENDAR ENABLED TIMEOUT COMMAND_B64 [CPU_PERCENT MEMORY_MB TASKS_MAX]' >&2; exit 64; }
    name=$3; runtime=$4; on_calendar=$5; enabled=$6; timeout=$7; command_b64=$8
    # Accept standard Base64 with optional padding (=) for cross-platform compatibility
    [[ $name =~ ^[A-Za-z0-9_-]{1,32}$ && $runtime =~ ^(php|node|python|shell)$ && $enabled =~ ^[01]$ && $timeout =~ ^[0-9]+$ && $command_b64 =~ ^[A-Za-z0-9+/]+=*$ ]] || { echo 'invalid scheduled task parameters' >&2; exit 1; }
    (( timeout >= 1 && timeout <= 86400 )) || { echo 'invalid scheduled task timeout' >&2; exit 1; }
    task_cpu=100; task_memory=1024; task_tasks=256
    if (( $# == 11 )); then
      task_cpu=$9; task_memory=${10}; task_tasks=${11}
      [[ $task_cpu =~ ^[0-9]+$ && $task_memory =~ ^[0-9]+$ && $task_tasks =~ ^[0-9]+$ ]] || { echo 'invalid scheduled task resource limits' >&2; exit 1; }
      (( task_cpu >= 25 && task_cpu <= 6400 && task_memory >= 64 && task_memory <= 1048576 && task_tasks >= 16 && task_tasks <= 100000 )) || { echo 'scheduled task resource limits out of range' >&2; exit 1; }
    fi
    systemd-analyze calendar "$on_calendar" >/dev/null || { echo 'invalid systemd calendar expression' >&2; exit 1; }
    root="/var/www/sites/$site/public"; task_root="/var/lib/stepanel/tasks/$site"; install -d -m 0755 -o root -g root /var/lib/stepanel/tasks "$task_root"
    script="$task_root/$name.sh"; staged=$(mktemp "$task_root/.stepanel-task.XXXXXX")
    # Decode base64 command (supports both padded and unpadded variants)
    decoded_command=$(printf '%s' "$command_b64" | base64 -d)
    # %q quotes the whole decoded command as a single shell word, so
    # `bash -lc` receives it as ONE argument (its command string) rather than
    # splitting on whitespace into $0/$1/... positional parameters.
    { printf '#!/usr/bin/env bash\nset -Eeuo pipefail\ncd %q\n' "$root"; printf 'exec /bin/bash -lc %q\n' "$decoded_command"; } > "$staged"
    chown root:root "$staged"; chmod 0755 "$staged"; mv -f "$staged" "$script"
    unit="stepanel-task-${site}-${name}.service"; timer="stepanel-task-${site}-${name}.timer"
    cat > "/etc/systemd/system/$unit" <<EOF
[Unit]
Description=StePanel scheduled task $site/$name
After=stepanel-site-$site.slice
[Service]
Type=oneshot
User=$site_user
Group=$site_user
Slice=stepanel-site-$site.slice
WorkingDirectory=$root
ExecStart=$script
TimeoutStartSec=${timeout}s
CPUQuota=${task_cpu}%
MemoryMax=${task_memory}M
TasksMax=$task_tasks
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=$root
EnvironmentFile=-/etc/stepanel/environment/$site.env
UMask=0027
EOF
    cat > "/etc/systemd/system/$timer" <<EOF
[Unit]
Description=StePanel scheduled task timer $site/$name
[Timer]
OnCalendar=$on_calendar
Persistent=true
Unit=$unit
[Install]
WantedBy=timers.target
EOF
    chmod 0644 "/etc/systemd/system/$unit" "/etc/systemd/system/$timer"; chown root:root "/etc/systemd/system/$unit" "/etc/systemd/system/$timer"; systemctl daemon-reload
    if [[ $enabled == 1 ]]; then systemctl enable --now "$timer"; else systemctl disable --now "$timer" 2>/dev/null || true; fi ;;
  task-delete)
    (( $# == 3 )) || { echo 'usage: stepanel-appctl task-delete SITE NAME' >&2; exit 64; }
    name=$3; [[ $name =~ ^[A-Za-z0-9_-]{1,32}$ ]] || { echo 'invalid task name' >&2; exit 1; }
    unit="stepanel-task-${site}-${name}.service"; timer="stepanel-task-${site}-${name}.timer"; systemctl disable --now "$timer" 2>/dev/null || true; rm -f "/etc/systemd/system/$unit" "/etc/systemd/system/$timer" "/var/lib/stepanel/tasks/$site/$name.sh" "/var/www/sites/$site/.stepanel-tasks/$name.sh"; systemctl daemon-reload ;;
  env-apply)
    (( $# == 2 )) || { echo 'usage: stepanel-appctl env-apply SITE' >&2; exit 64; }
    install -d -m 0700 -o root -g root /etc/stepanel/environment
    target="/etc/stepanel/environment/$site.env"
    staged=$(mktemp /etc/stepanel/environment/.stepanel-env.XXXXXX)
    while IFS= read -r line; do
      [[ -z $line ]] && continue
      [[ $line =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || { rm -f "$staged"; echo 'invalid environment entry' >&2; exit 1; }
      printf '%s\n' "$line" >> "$staged"
    done
    chown root:root "$staged"; chmod 0600 "$staged"
    # Reconciliation is intentionally idempotent: avoid rewriting the
    # environment file and restarting every managed service when the desired
    # content is already present. Never compare through a symlink.
    if [[ -f $target && ! -L $target ]] && cmp -s "$staged" "$target"; then
      rm -f "$staged"
      chmod 0600 "$target"
      chown root:root "$target"
      exit 0
    fi
    mv -f "$staged" "$target"
    systemctl try-restart "stepanel-app-$site.service" "stepanel-app-$site-python.service" 2>/dev/null || true
    mapfile -t worker_units < <(systemctl list-unit-files --type=service --no-legend "stepanel-worker-$site-*.service" 2>/dev/null | awk '{print $1}')
    if (( ${#worker_units[@]} > 0 )); then
      systemctl try-restart "${worker_units[@]}" 2>/dev/null || true
    fi ;;
  python-start|python-stop|python-restart)
    (( $# == 2 )) || { echo "usage: stepanel-appctl $action SITE" >&2; exit 64; }
    systemctl "${action#python-}" "stepanel-app-${site}-python.service" ;;
  worker-start|worker-stop|worker-restart)
    (( $# == 3 )) || { echo "usage: stepanel-appctl $action SITE NAME" >&2; exit 64; }
    name=$3; [[ $name =~ ^[A-Za-z0-9_-]{1,32}$ ]] || { echo 'invalid worker name' >&2; exit 1; }
    systemctl "${action#worker-}" "stepanel-worker-${site}-${name}.service" ;;
  *) echo 'usage: stepanel-appctl apply|python-start|python-stop|python-restart|worker-start|worker-stop|worker-restart SITE ...' >&2; exit 64 ;;
esac
