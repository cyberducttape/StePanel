    notify_env="$task_root/$name.env"; notify_staged=$(mktemp "$task_root/.stepanel-task-env.XXXXXX")
    if [[ -n $webhook ]]; then printf 'STEPANEL_TASK_WEBHOOK_URL=%s\n' "$webhook" > "$notify_staged"; fi
