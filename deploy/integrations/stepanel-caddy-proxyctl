#!/usr/bin/env bash
set -Eeuo pipefail
[[ $EUID -eq 0 ]] || { echo 'must run as root' >&2; exit 1; }
root=/etc/caddy/stepanel.d
service=caddy
install -d -m 0755 -o root -g root "$root"
exec 9>/run/lock/stepanel-caddy.lock; flock -x 9
valid_backend() {
  local backend=$1 host port first second third fourth
  port=${backend##*:}
  host=${backend%:*}
  [[ $port =~ ^[0-9]{1,5}$ ]] && (( port >= 1 && port <= 65535 )) || return 1
  [[ $host == localhost || $host == '[::1]' ]] && return 0
  [[ $host != 169.254.169.254 && $host != 100.100.100.200 && $host != '[fd00:ec2::254]' ]] || return 1
  [[ $host =~ ^\[([fF][cCdD][0-9A-Fa-f:]*|[fF][eE][89aAbB][0-9A-Fa-f:]*)\]$ ]] && return 0
  [[ $host =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 1
  IFS=. read -r first second third fourth <<< "$host"
  (( first <= 255 && second <= 255 && third <= 255 && fourth <= 255 )) || return 1
  (( first == 10 || first == 127 || first == 192 && second == 168 || first == 172 && second >= 16 && second <= 31 ))
}
case "${1:-}" in
apply)
  (( $# == 4 )) || { echo 'usage: stepanel-caddy-proxyctl apply SITE DOMAIN BACKEND' >&2; exit 64; }
  site=$2; domain=${3,,}; backend=$4
  [[ $site =~ ^[a-z0-9_-]{1,32}$ && $domain =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || { echo 'invalid site or domain' >&2; exit 1; }
  valid_backend "$backend" || { echo 'invalid backend' >&2; exit 1; }
  path="$root/${site}-${domain//./_}.caddy"
  # The file name does not identify its site (alice-shop-example_org is
  # alice's shop-example.org and alice-shop's example.org proxy); never
  # overwrite a proxy that serves another domain.
  if [[ -e $path ]]; then
    [[ $(awk '/^[[:space:]]*(#|$)/ { next } { if (NF == 2 && $2 == "{") print tolower($1); exit }' "$path") == "$domain" ]] || { echo 'proxy file already serves another domain' >&2; exit 1; }
  fi
  backup=''; [[ -f "$path" ]] && backup=$(mktemp) && cp -p "$path" "$backup"
  tmp=$(mktemp "$root/.stepanel.XXXXXX"); trap 'rm -f "$tmp" "$backup"' EXIT
  printf '%s {\n\treverse_proxy %s\n}\n' "$domain" "$backend" > "$tmp"; chmod 0644 "$tmp"; chown root:root "$tmp"; mv -f "$tmp" "$path"
  if ! caddy validate --config /etc/caddy/Caddyfile >/dev/null || ! systemctl reload "$service"; then
    if [[ -n "$backup" ]]; then mv -f "$backup" "$path"; else rm -f "$path"; fi
    if caddy validate --config /etc/caddy/Caddyfile >/dev/null; then systemctl reload "$service" || true; fi
    exit 1
  fi
  ;;
delete)
  (( $# == 2 || $# == 3 )) || { echo 'usage: stepanel-caddy-proxyctl delete NAME [DOMAIN]' >&2; exit 64; }
  [[ $2 =~ ^[a-z0-9_-]{1,32}-[a-z0-9_-]+\.caddy$ ]] || { echo 'invalid proxy name' >&2; exit 1; }
  expected=${3:-}; [[ -z $expected || $expected =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || { echo 'invalid expected domain' >&2; exit 1; }
  path="$root/$2"; [[ -f $path && ! -L $path ]] || { echo 'proxy not found' >&2; exit 1; }
  [[ -z $expected || $(awk '/^[[:space:]]*(#|$)/ { next } { if (NF == 2 && $2 == "{") print tolower($1); exit }' "$path") == "$expected" ]] || { echo 'proxy serves another domain; refusing to delete it' >&2; exit 1; }
  backup=$(mktemp); cp -p "$path" "$backup"; rm -f "$path"
  if ! caddy validate --config /etc/caddy/Caddyfile >/dev/null || ! systemctl reload "$service"; then
    mv -f "$backup" "$path"
    if caddy validate --config /etc/caddy/Caddyfile >/dev/null; then systemctl reload "$service" || true; fi
    exit 1
  fi
  rm -f "$backup"; ;;
*) echo 'usage: stepanel-caddy-proxyctl apply SITE DOMAIN BACKEND | delete NAME [DOMAIN]' >&2; exit 64;;
esac
