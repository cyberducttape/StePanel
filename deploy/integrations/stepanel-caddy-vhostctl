#!/usr/bin/env bash
set -Eeuo pipefail
[[ $EUID -eq 0 ]] || { echo 'must run as root' >&2; exit 1; }

root=/etc/caddy/stepanel.d
service=caddy
action=${1:-}
command -v caddy >/dev/null 2>&1 || { echo 'caddy is unavailable' >&2; exit 1; }
command -v flock >/dev/null 2>&1 || { echo 'flock is required for Caddy configuration locking' >&2; exit 1; }
command -v findmnt >/dev/null 2>&1 || { echo 'findmnt is required for Caddy filesystem isolation' >&2; exit 1; }
command -v systemd-escape >/dev/null 2>&1 || { echo 'systemd-escape is required for Caddy filesystem isolation' >&2; exit 1; }
install -d -m 0755 -o root -g root "$root"
view_root=/var/www/.stepanel-caddy-views
install -d -m 0755 -o root -g root "$view_root"
exec 9>/run/lock/stepanel-caddy.lock
flock -x 9
location_lib=/usr/local/lib/stepanel/site-location.sh
[[ -f $location_lib && ! -L $location_lib && $(stat -c '%u' -- "$location_lib") == 0 && $(( 8#$(stat -c '%a' -- "$location_lib") & 022 )) == 0 ]] || { echo 'site location library is missing or unsafe' >&2; exit 1; }
# shellcheck source=stepanel-site-location.sh
. "$location_lib"

view_path() { printf '%s/%s\n' "$view_root" "$1"; }
view_mount_changed=0

# Caddy's systemd unit may have a private mount namespace. A bind mount added
# after Caddy started is then invisible to an admin-API reload. Restart only
# when a site's stable view mount changes so the service receives a fresh
# namespace; ordinary route edits remain graceful reloads.
activate_caddy() {
  if (( view_mount_changed )); then
    systemctl restart "$service"
  else
    systemctl reload "$service"
  fi
}

mount_unit() {
  systemd-escape --path --suffix=mount "$1"
}

mount_unit_path() {
  printf '/etc/systemd/system/%s\n' "$(mount_unit "$1")"
}

# ProtectSystem=strict gives the root broker a private mount namespace. The
# systemd manager mounts these units in PID 1's host namespace, so validate
# their presence and options against that namespace rather than the broker's.
host_findmnt() {
  findmnt --task 1 "$@"
}

remove_legacy_fstab_target() {
  local target=$1 temp
  [[ -f /etc/fstab && ! -L /etc/fstab ]] || return 0
  awk -v target="$target" '$2 == target { found=1 } END { exit !found }' /etc/fstab || return 0
  temp=$(mktemp /etc/.stepanel-fstab.XXXXXX)
  awk -v target="$target" '$2 != target' /etc/fstab > "$temp"
  chmod 0644 "$temp"
  chown root:root "$temp"
  mv -f "$temp" /etc/fstab
  reload_mount_units
}

reload_mount_units() {
  systemctl daemon-reload
}

stop_managed_mount() {
  local target=$1 unit
  unit=$(mount_unit "$target")
  if systemctl is-active --quiet "$unit"; then
    systemctl stop "$unit"
  elif [[ $(host_findmnt -no TARGET -T "$target" 2>/dev/null || true) == "$target" ]]; then
    echo "mount $target exists outside its systemd mount unit; refusing namespace-local unmount" >&2
    return 1
  fi
  [[ $(host_findmnt -no TARGET -T "$target" 2>/dev/null || true) != "$target" ]] || {
    echo "systemd mount unit left $target mounted" >&2
    return 1
  }
}

write_mount_unit() {
  local target=$1 source=$2 unit_path temp
  unit_path=$(mount_unit_path "$target")
  temp=$(mktemp /etc/systemd/system/.stepanel-caddy-view.XXXXXX)
  {
    printf '[Unit]\nDescription=StePanel isolated Caddy view %s\nRequiresMountsFor=%s %s\nBefore=caddy.service\n\n' "$target" "$source" "$target"
    printf '[Mount]\nWhat=%s\nWhere=%s\nType=none\nOptions=bind,nosymfollow\n\n[Install]\nWantedBy=local-fs.target\n' "$source" "$target"
  } > "$temp"
  chmod 0644 "$temp"
  chown root:root "$temp"
  mv -f "$temp" "$unit_path"
}

remove_mount_unit() {
  local target=$1 unit unit_path
  unit=$(mount_unit "$target")
  unit_path=$(mount_unit_path "$target")
  [[ ! -L $unit_path ]] || { echo "refusing symlinked Caddy mount unit $unit_path" >&2; return 1; }
  if [[ -f $unit_path && ! -L $unit_path ]]; then
    stop_managed_mount "$target"
    systemctl disable "$unit" >/dev/null
    rm -f -- "$unit_path"
    reload_mount_units
  else
    stop_managed_mount "$target"
    remove_legacy_fstab_target "$target"
  fi
}

start_managed_mount() {
  local target=$1 source=$2 unit
  write_mount_unit "$target" "$source"
  reload_mount_units
  unit=$(mount_unit "$target")
  systemctl enable "$unit"
  systemctl start "$unit"
  [[ $(host_findmnt -no TARGET -T "$target" 2>/dev/null || true) == "$target" ]] || {
    echo "systemd did not expose the Caddy view mount $target to the helper" >&2
    return 1
  }
}

remove_legacy_view() {
  local site=$1 old="$view_root/$1/public" view
  view=$(view_path "$site")
  remove_mount_unit "$old"
  # Once the stable parent is mounted, this pathname reaches the customer's
  # real document root. Only remove a legacy mountpoint beneath the detached
  # view directory, never the source tree.
  if [[ $(host_findmnt -no TARGET -T "$view" 2>/dev/null || true) != "$view" ]]; then
    rmdir "$old" 2>/dev/null || true
  fi
}

remove_view() {
  local site=$1 view
  view=$(view_path "$site")
  remove_mount_unit "$view"
  remove_legacy_view "$site"
  rmdir "$view" 2>/dev/null || true
}

ensure_view() {
  local site=$1 site_home=$2 view options mounted_identity source_identity
  view=$(view_path "$site")
  # Remove mounts created by older releases from /etc/fstab before publishing
  # the equivalent persistent native unit. With no legacy entry this is a
  # no-op, so hosts without /etc/fstab remain fully supported.
  if [[ -f /etc/fstab ]] && awk -v target="$view" '$2 == target { found=1 } END { exit !found }' /etc/fstab; then
    stop_managed_mount "$view"
    remove_legacy_fstab_target "$view"
    view_mount_changed=1
  fi
  if [[ $(host_findmnt -no TARGET -T "$view" 2>/dev/null || true) != "$view" ]]; then
    install -d -m 0755 -o root -g root "$view"
  fi
  # Migrate the former public-directory mount. Mounting its stable parent
  # makes later atomic swaps of public/public_html/domain visible to Caddy.
  remove_legacy_view "$site"
  if [[ $(host_findmnt -no TARGET -T "$view" 2>/dev/null || true) != "$view" ]]; then
    start_managed_mount "$view" "$site_home"
    view_mount_changed=1
  else
    mounted_identity=$(stat -Lc '%d:%i' -- "$view")
    source_identity=$(stat -Lc '%d:%i' -- "$site_home")
    if [[ $mounted_identity != "$source_identity" ]]; then
      stop_managed_mount "$view"
      start_managed_mount "$view" "$site_home"
      view_mount_changed=1
    fi
  fi
  options=$(host_findmnt -no OPTIONS -T "$view" 2>/dev/null || true)
  if [[ ,$options, != *,nosymfollow,* ]]; then
    echo "Caddy view $view is missing nosymfollow (observed mount options: ${options:-unavailable})" >&2
    systemctl show "$(mount_unit "$view")" -p ActiveState -p SubState -p Result -p What -p Where -p Options >&2 || true
    remove_view "$site"
    return 1
  fi
}

if [[ $action == delete ]]; then
  (( $# == 2 )) || { echo 'usage: stepanel-caddy-vhostctl delete NAME' >&2; exit 64; }
  name=$2
  [[ $name =~ ^site-[a-z0-9_-]{1,32}-[a-z0-9_-]+\.caddy$ ]] || { echo 'invalid site route name' >&2; exit 1; }
  path="$root/$name"
  [[ ! -L $path ]] || { echo 'site route is unsafe' >&2; exit 1; }
  if [[ ! -e $path ]]; then
    # A previous delete may have removed the include file before the caller
    # durably recorded route cleanup. Revalidate and reload so replay also
    # reconciles Caddy's in-memory configuration before succeeding.
    caddy validate --config /etc/caddy/Caddyfile >/dev/null || { echo 'Caddy configuration is invalid after route deletion' >&2; exit 1; }
    systemctl reload "$service" || { echo 'could not reload Caddy after route deletion' >&2; exit 1; }
    exit 0
  fi
  [[ -f $path ]] || { echo 'site route is not a regular file' >&2; exit 1; }
  configured_root=$(awk '$1 == "root" && $2 == "*" { print $3; exit }' "$path")
  [[ $configured_root =~ ^/var/www/\.stepanel-caddy-views/[a-z0-9_-]{1,32}/[a-z0-9._-]+$ ]] || { echo 'managed route does not use an isolated Caddy view' >&2; exit 1; }
  site=${configured_root#"$view_root/"}; site=${site%%/*}
  stepanel_site_location "$site" || exit 1
  view=$(view_path "$site")
  [[ $configured_root == "$view/$site_directory" ]] || { echo 'managed route document root does not match the site location' >&2; exit 1; }
  [[ -d $public_root && ! -L $public_root ]] || { echo 'site document root is unavailable or unsafe' >&2; exit 1; }
  backup=$(mktemp)
  trap 'rm -f "$backup"' EXIT
  view_was_mounted=0
  systemctl is-active --quiet "$(mount_unit "$view")" && view_was_mounted=1
  cp -p "$path" "$backup"
  remove_view "$site"
  rm -f "$path"
  if ! caddy validate --config /etc/caddy/Caddyfile >/dev/null || \
    { (( view_was_mounted )) && systemctl restart "$service"; } || \
    { (( ! view_was_mounted )) && systemctl reload "$service"; }; then
    mv -f "$backup" "$path"
    ensure_view "$site" "$site_home" || true
    if caddy validate --config /etc/caddy/Caddyfile >/dev/null; then activate_caddy || true; fi
    exit 1
  fi
  exit 0
fi

site=${2:-}
domain=${3,,}
[[ $site =~ ^[a-z0-9_-]{1,32}$ ]] || { echo 'invalid site' >&2; exit 1; }
[[ $domain =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || { echo 'invalid domain' >&2; exit 1; }
(( ${#site} + ${#domain} <= 220 )) || { echo 'site and domain combination is too long' >&2; exit 1; }
stepanel_site_location "$site" || exit 1
[[ -d $public_root && ! -L $public_root ]] || { echo 'site document root is unavailable or unsafe' >&2; exit 1; }
# Caddy's file_server follows symlinks, so a site tree containing one is not a
# filesystem boundary. Reject such trees before publishing a route; imports
# and deployments must use regular files and directories only. node_modules
# is exempt because package managers link its contents, and the route below
# never serves it.
symlink=$(find -P "$public_root" -xdev -path "$public_root/node_modules" -prune -o -type l -print -quit)
[[ -z $symlink ]] || { echo "site document root contains a symlink: $symlink" >&2; exit 1; }
socket=
selected_version=
profile="$php_state/runtime.env"
web_group_config=/etc/ste-panel.env
[[ -f $web_group_config && ! -L $web_group_config ]] || { echo 'authoritative web identity configuration is unavailable' >&2; exit 1; }
[[ $(stat -c %u "$web_group_config") == 0 && $(( 8#$(stat -c %a "$web_group_config") & 077 )) == 0 ]] || { echo 'authoritative web identity configuration is not root-owned and private' >&2; exit 1; }
socket_root=$(sed -n 's/^STEPANEL_PHP_SOCKET_ROOT="\(\/[^"[:space:]]*\)"$/\1/p' "$web_group_config")
[[ $socket_root == /* && $socket_root != *$'\n'* && $socket_root != *$'\r'* && $socket_root != *' '* ]] || { echo 'authoritative PHP socket root is invalid' >&2; exit 1; }
[[ ! -f $profile || -L $profile ]] || selected_version=$(awk -F= '$1 == "php_version" { gsub(/['"'"'\047]/, "", $2); print $2; exit }' "$profile")
if [[ -n $selected_version ]]; then candidates=("$socket_root/stepanel-$site-$selected_version.sock" "$socket_root/stepanel-$site.sock"); else candidates=("$socket_root/stepanel-$site-"*.sock "$socket_root/stepanel-$site.sock"); fi
for candidate in "${candidates[@]}"; do
  [[ -S $candidate ]] || continue
  socket=$candidate
  break
done
[[ -n $socket ]] || { echo 'an active isolated PHP-FPM socket was not found for this site' >&2; exit 1; }

view_root_path=$(view_path "$site")
document_root="$view_root_path/$site_directory"
view_was_mounted=0
systemctl is-active --quiet "$(mount_unit "$view_root_path")" && view_was_mounted=1
ensure_view "$site" "$site_home" || { echo 'could not establish a nosymfollow Caddy view' >&2; exit 1; }

name="site-${site}-${domain//./_}.caddy"
path="$root/$name"
backup=$(mktemp)
staged=$(mktemp "$root/.stepanel-site.XXXXXX")
existed=0
[[ ! -f $path ]] || { cp -p "$path" "$backup"; existed=1; }
cleanup() { rm -f "$backup" "$staged"; }
restore() {
  if (( existed )); then mv -f "$backup" "$path"; else rm -f "$path"; fi
  if (( ! view_was_mounted )); then remove_view "$site" || true; fi
  if caddy validate --config /etc/caddy/Caddyfile >/dev/null; then activate_caddy || true; fi
}
trap cleanup EXIT

case "$action" in
  apply|apply-auth|import-htaccess)
    [[ ( $action == "apply-auth" && $# -eq 5 ) || ( $action != "apply-auth" && $# -eq 3 ) ]] || { echo "invalid vhost arguments" >&2; exit 64; }
    auth_user=${4:-}; auth_hash=${5:-}
    bcrypt_pattern='^\$2[aby]\$[0-9]{2}\$[./A-Za-z0-9]{53}$'
    if [[ $action == apply-auth ]]; then [[ $auth_user =~ ^[A-Za-z0-9._-]{1,64}$ && $auth_hash =~ $bcrypt_pattern ]] || { echo 'invalid Basic Auth credentials' >&2; exit 1; }; fi
    {
      printf '# Managed by StePanel. Manual changes will be replaced.\n%s {\n\troot * %s\n\tencode zstd gzip\n' "$domain" "$document_root"
      cat <<'EOF'
	@stepanel_sensitive path_regexp stepanel_sensitive (?i)^/(.*/)?(node_modules(/.*)?|\.env(\.[^/]*)?|\.git(/.*)?|\.svn(/.*)?|\.hg(/.*)?|\.ssh(/.*)?|\.aws(/.*)?|\.gnupg(/.*)?|\.htpasswd|\.htaccess|[^/]+\.(sql|sqlite3?|db|dump|log|bak|backup|old|orig|save|tar|tgz|zip|7z|rar|gz|bz2|xz|zst|enc|pem|key|p12|pfx)(\.[^/]*)?)$
	respond @stepanel_sensitive 404
	# Directory names alone are not secrets: block them only where the path
	# exists in the document root, so application routes such as /private/
	# still reach the front controller.
	@stepanel_sensitive_dirs {
		path_regexp stepanel_sensitive_dirs (?i)^/(.*/)?(backup|backups|private)(/.*)?$
		file {path} {path}/
	}
	respond @stepanel_sensitive_dirs 404
EOF
      if [[ -f "$site_private/.stepanel-staging-noindex" && ! -L "$site_private/.stepanel-staging-noindex" ]]; then printf '\theader X-Robots-Tag "noindex, nofollow"\n'; fi
      if [[ $action == apply-auth ]]; then printf '\tbasic_auth {\n\t\t%s %s\n\t}\n' "$auth_user" "$auth_hash"; fi
      if [[ $action == import-htaccess ]]; then
        count=0
        while IFS= read -r line; do
          [[ -n $line ]] || continue
          (( ++count <= 100 )) || { echo 'too many translated directives' >&2; exit 1; }
          if [[ $line == 'try_files {path} {path}/ /index.php?{query}' ]]; then
            printf '\t%s\n' "$line"
            continue
          fi
          read -r directive source destination code extra <<< "$line"
          [[ $directive == redir && -z ${extra:-} && $source =~ ^/[A-Za-z0-9._~!$\&\(\)*+,\;=:@%/-]*$ && $destination =~ ^(https?://[A-Za-z0-9._~!$\&\(\)*+,\;=:@%/?#:+-]+|/[A-Za-z0-9._~!$\&\(\)*+,\;=:@%/?+-]+)$ && $code =~ ^3[0-9][0-9]$ ]] || { echo 'unsafe translated directive' >&2; exit 1; }
          printf '\tredir %s %s %s\n' "$source" "$destination" "$code"
        done
      fi
      # Caddy's PHP file matcher can treat the document-root directory as an
      # existing path and let `/` fall through to file_server. When this site
      # has a real PHP front controller, rewrite the exact root path directly;
      # the helper verifies the file as root so this does not depend on Caddy's
      # view-mount file matcher. A path-only rewrite preserves the query string.
      if [[ -f "$public_root/index.php" && ! -L "$public_root/index.php" ]]; then
	printf '\t@stepanel_php_root path /\n\trewrite @stepanel_php_root /index.php\n'
      fi
      # Caddy reads through the root-owned nosymfollow bind view, but the
      # per-site PHP-FPM account and open_basedir use the canonical site path.
      # Pass that canonical path to FastCGI instead of the Caddy-only view.
      printf '\tphp_fastcgi unix/%s {\n\t\troot %s\n\t}\n\tfile_server {\n\t\thide %s/.env %s/.env.* %s/.git %s/.git/* %s/.svn %s/.svn/* %s/.hg %s/.hg/* %s/.htpasswd %s/.htaccess\n\t}\n}\n' "$socket" "$public_root" "$document_root/.env" "$document_root/.env.*" "$document_root/.git" "$document_root/.git/*" "$document_root/.svn" "$document_root/.svn/*" "$document_root/.hg" "$document_root/.hg/*" "$document_root/.htpasswd" "$document_root/.htaccess"
    } > "$staged"
    chmod 0644 "$staged"
    chown root:root "$staged"
    mv -f "$staged" "$path"
    if ! caddy validate --config /etc/caddy/Caddyfile >/dev/null || ! activate_caddy; then
      restore
      exit 1
    fi
    ;;
  *) echo 'usage: stepanel-caddy-vhostctl apply|import-htaccess SITE DOMAIN | delete NAME' >&2; exit 64 ;;
esac
