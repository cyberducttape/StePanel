#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $EUID -ne 0 ]]; then echo 'must run as root' >&2; exit 1; fi
action=${1:-}
registry=/var/lib/stepanel-privileged/db-managed
engine=mysql
if [[ -r /etc/stepanel-dbctl.conf ]]; then
  IFS='=' read -r config_key engine < /etc/stepanel-dbctl.conf
  [[ $config_key == engine ]] || { echo 'invalid database helper configuration' >&2; exit 1; }
fi
[[ $engine == mysql || $engine == mariadb || $engine == postgresql ]] || { echo 'invalid database helper engine' >&2; exit 1; }
install -d -m 0700 -o root -g root "$registry"
lock_dir="$registry/.locks"
install -d -m 0700 -o root -g root "$lock_dir"
lock_fds=()

lock_resources() {
  local lock_name fd
  local -a sorted
  mapfile -t sorted < <(printf '%s\n' "$@" | LC_ALL=C sort -u)
  for lock_name in "${sorted[@]}"; do
    [[ $lock_name =~ ^(database|site|user)-[a-z0-9_-]{1,64}$ ]] || { echo 'invalid internal database lock key' >&2; return 1; }
    exec {fd}>"$lock_dir/$lock_name.lock"
    flock -x "$fd"
    lock_fds+=("$fd")
  done
}

unlock_resources() {
  local fd
  for fd in "${lock_fds[@]}"; do
    flock -u "$fd"
    exec {fd}>&-
  done
  lock_fds=()
}

if [[ $engine == postgresql ]]; then
  admin=(runuser -u postgres -- psql --no-psqlrc --no-password --set ON_ERROR_STOP=1 --tuples-only --no-align --dbname postgres)
else
  client=mysql
  command -v mariadb >/dev/null 2>&1 && client=mariadb
  admin=("$client" --protocol=socket --batch --skip-column-names)
fi

sql() { printf '%s;\n' "$1" | "${admin[@]}"; }
sql_secret() { printf '%s;\n' "$1" | "${admin[@]}" >/dev/null 2>&1 || { echo 'credential operation failed' >&2; return 1; }; }
valid_database() { if [[ $engine == postgresql ]]; then [[ $1 =~ ^[a-z0-9_]{1,63}$ ]]; else [[ $1 =~ ^[a-z0-9_]{1,64}$ ]]; fi; }
valid_user() { [[ $1 =~ ^[a-z][a-z0-9_]{0,31}$ ]]; }
valid_site() { [[ $1 =~ ^[a-z0-9_-]{1,32}$ ]]; }

record_site() {
  local value=$1 rest
  if [[ $value == pending-* ]]; then value=${value#pending-}; fi
  case "$value" in
    cpmove:*) rest=${value#*:}; printf '%s' "${rest%%:*}" ;;
    wordpress:*|panel:*) rest=${value#*:}; printf '%s' "${rest%%:*}" ;;
  esac
}

register_database() {
  local database=$1 value=$2 staged
  staged=$(mktemp "$registry/.database.XXXXXX")
  printf '%s\n' "$value" > "$staged"
  chmod 0600 "$staged"
  sync -d "$staged"
  mv -f "$staged" "$registry/$database"
  sync -d "$registry"
}

remove_record() {
  local record=$1
  rm -f "$record"
  sync -d "$registry"
}

database_exists() {
  local database=$1 count
  if [[ $engine == postgresql ]]; then count=$(sql "SELECT COUNT(*) FROM pg_database WHERE datname='$database'"); else count=$(sql "SELECT COUNT(*) FROM information_schema.SCHEMATA WHERE SCHEMA_NAME='$database'"); fi
  [[ $count != 0 ]]
}

user_exists() {
  local user=$1 count
  if [[ $engine == postgresql ]]; then count=$(sql "SELECT COUNT(*) FROM pg_roles WHERE rolname='$user'"); else count=$(sql "SELECT COUNT(*) FROM mysql.user WHERE User='$user' AND Host='localhost'"); fi
  [[ $count != 0 ]]
}

drop_objects() {
  local database=$1 user=$2
  if [[ $engine == postgresql ]]; then
    sql "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='$database' AND pid <> pg_backend_pid()" >/dev/null
    sql "DROP DATABASE IF EXISTS \"$database\""
    sql "DROP ROLE IF EXISTS \"$user\""
  else
    sql "DROP DATABASE IF EXISTS \`$database\`; DROP USER IF EXISTS '$user'@'localhost'"
  fi
}

if [[ $action == reconcile ]]; then
  (( $# == 1 )) || { echo 'usage: stepanel-dbctl reconcile' >&2; exit 64; }
  for record in "$registry"/*; do
    [[ -f $record ]] || continue
    database=${record##*/}; valid_database "$database" || { echo "invalid registry entry: $database" >&2; exit 1; }
    value=$(<"$record")
    unset importer db_user site
    cleanup_user=
    lock_keys=("database-$database")
    case "$value" in
      pending-cpmove:*)
        importer=${value##*:}; valid_user "$importer" || exit 1
        site=$(record_site "$value"); valid_site "$site" || exit 1
        cleanup_user=$importer
        lock_keys+=("site-$site" "user-$importer") ;;
      pending-wordpress:*|pending-panel:*)
        db_user=${value##*:}; valid_user "$db_user" || exit 1
        site=$(record_site "$value"); valid_site "$site" || exit 1
        cleanup_user=$db_user
        lock_keys+=("site-$site" "user-$db_user") ;;
      *) continue ;;
    esac
    lock_resources "${lock_keys[@]}"
    if [[ ! -f $record || $(<"$record") != "$value" ]]; then
      unlock_resources
      continue
    fi
    drop_objects "$database" "$cleanup_user"
    remove_record "$record"
    unlock_resources
  done
  exit 0
fi

if [[ $action == list ]]; then
  (( $# == 2 )) || { echo 'usage: stepanel-dbctl list SITE' >&2; exit 64; }
  site=$2; valid_site "$site" || { echo 'invalid site' >&2; exit 1; }
  for record in "$registry"/*; do
    [[ -f $record ]] || continue
    database=${record##*/}; valid_database "$database" || exit 1; value=$(<"$record")
    [[ $value == "cpmove:$site" || $value == "wordpress:$site:"* || $value == "panel:$site:"* ]] && printf '%s\t%s\n' "$database" "$value"
  done
  exit 0
fi

if [[ $action == inventory ]]; then
  (( $# == 1 )) || { echo 'usage: stepanel-dbctl inventory' >&2; exit 64; }
  for record in "$registry"/*; do
    [[ -f $record ]] || continue
    database=${record##*/}; valid_database "$database" || exit 1; value=$(<"$record"); [[ $value != pending-* ]] || continue
    site=unknown; db_user=
    case "$value" in cpmove:*) site=${value#*:} ;; wordpress:*|panel:*) rest=${value#*:}; site=${rest%%:*}; db_user=${rest##*:} ;; esac
    if [[ $engine == postgresql ]]; then
      details=$(sql "SELECT pg_database_size(d.datname)::text || E'\\t' || pg_get_userbyid(d.datdba) FROM pg_database d WHERE d.datname='$database'")
    else
      details=$(sql "SELECT CONCAT(COALESCE(SUM(data_length+index_length),0), CHAR(9), COALESCE(DEFAULT_CHARACTER_SET_NAME,'unknown')) FROM information_schema.SCHEMATA s LEFT JOIN information_schema.TABLES t ON t.TABLE_SCHEMA=s.SCHEMA_NAME WHERE s.SCHEMA_NAME='$database' GROUP BY s.SCHEMA_NAME, s.DEFAULT_CHARACTER_SET_NAME")
    fi
    [[ -n $details ]] || continue
    printf '%s\t%s\t%s\t%s\t%s\n' "$database" "$site" "$db_user" "${details%%$'\t'*}" "${details#*$'\t'}"
  done
  exit 0
fi

if [[ $action == diagnostics ]]; then
  (( $# == 1 )) || { echo 'usage: stepanel-dbctl diagnostics' >&2; exit 64; }
  if [[ $engine == postgresql ]]; then
    sql "SELECT 'connections' || E'\\t' || COUNT(*) FROM pg_stat_activity; SELECT 'active_connections' || E'\\t' || COUNT(*) FROM pg_stat_activity WHERE state='active'; SELECT 'long_transactions' || E'\\t' || COUNT(*) FROM pg_stat_activity WHERE xact_start < now()-interval '5 minutes'; SELECT 'blocked_sessions' || E'\\t' || COUNT(*) FROM pg_stat_activity WHERE cardinality(pg_blocking_pids(pid)) > 0; SELECT 'deadlocks' || E'\\t' || COALESCE(SUM(deadlocks),0) FROM pg_stat_database; SELECT 'database_bytes' || E'\\t' || COALESCE(SUM(pg_database_size(datname)),0) FROM pg_database WHERE datallowconn"
  else
    sql "SELECT CONCAT('connections',CHAR(9),COUNT(*)) FROM information_schema.PROCESSLIST; SELECT CONCAT('active_connections',CHAR(9),COUNT(*)) FROM information_schema.PROCESSLIST WHERE COMMAND <> 'Sleep'; SELECT CONCAT('long_transactions',CHAR(9),COUNT(*)) FROM information_schema.innodb_trx WHERE trx_started < NOW()-INTERVAL 5 MINUTE; SELECT CONCAT('database_bytes',CHAR(9),COALESCE(SUM(data_length+index_length),0)) FROM information_schema.TABLES"
    deadlocks=$(sql "SHOW GLOBAL STATUS LIKE 'Innodb_deadlocks'" | awk '{print $2}')
    [[ $deadlocks =~ ^[0-9]+$ ]] && printf 'deadlocks\t%s\n' "$deadlocks"
    if [[ $engine == mariadb ]]; then blocked=$(sql "SELECT COUNT(*) FROM information_schema.INNODB_LOCK_WAITS"); else blocked=$(sql "SELECT COUNT(*) FROM performance_schema.data_lock_waits"); fi
    [[ $blocked =~ ^[0-9]+$ ]] && printf 'blocked_sessions\t%s\n' "$blocked"
  fi
  exit 0
fi

if [[ $action == sessions ]]; then
  (( $# == 1 )) || { echo 'usage: stepanel-dbctl sessions' >&2; exit 64; }
  if [[ $engine == postgresql ]]; then
    sql "SELECT pid || E'\\t' || COALESCE(usename,'') || E'\\t' || COALESCE(datname,'') || E'\\t' || COALESCE(state,'') || E'\\t' || COALESCE(EXTRACT(EPOCH FROM (now()-COALESCE(xact_start,query_start)))::bigint,0) || E'\\t' || COALESCE(wait_event_type,'') FROM pg_stat_activity WHERE pid <> pg_backend_pid() ORDER BY COALESCE(xact_start,query_start) NULLS LAST LIMIT 200"
  else
    sql "SELECT CONCAT(ID,CHAR(9),USER,CHAR(9),COALESCE(DB,''),CHAR(9),COMMAND,CHAR(9),TIME,CHAR(9),COALESCE(STATE,'')) FROM information_schema.PROCESSLIST WHERE ID <> CONNECTION_ID() ORDER BY TIME DESC LIMIT 200"
  fi
  exit 0
fi

if [[ $action == settings ]]; then
  (( $# == 1 )) || { echo 'usage: stepanel-dbctl settings' >&2; exit 64; }
  if [[ $engine == postgresql ]]; then
    sql "SELECT name || E'\\t' || setting || COALESCE(unit,'') FROM pg_settings WHERE name IN ('max_connections','shared_buffers','work_mem','maintenance_work_mem','effective_cache_size','wal_level','archive_mode','log_min_duration_statement','autovacuum') ORDER BY name"
  else
    sql "SHOW GLOBAL VARIABLES WHERE Variable_name IN ('max_connections','innodb_buffer_pool_size','innodb_log_file_size','slow_query_log','long_query_time','character_set_server','collation_server','binlog_format','log_bin')"
  fi
  exit 0
fi

if [[ $action == terminate ]]; then
  (( $# == 2 )) || { echo 'usage: stepanel-dbctl terminate SESSION_ID' >&2; exit 64; }
  session_id=$2; [[ $session_id =~ ^[1-9][0-9]{0,18}$ ]] || { echo 'invalid session ID' >&2; exit 1; }
  if [[ $engine == postgresql ]]; then sql "SELECT pg_terminate_backend($session_id)"; else sql "KILL CONNECTION $session_id"; fi
  exit 0
fi

database=${2:-}; valid_database "$database" || { echo 'invalid database name' >&2; exit 1; }
record="$registry/$database"

if [[ $action == restore-dump ]]; then
  (( $# == 3 )) || { echo 'usage: stepanel-dbctl restore-dump DATABASE SITE' >&2; exit 64; }
  site=$3; valid_site "$site" || { echo 'invalid site' >&2; exit 1; }
  lock_resources "database-$database" "site-$site"
  [[ -f $record ]] || { echo 'database is not registered as managed' >&2; exit 1; }
  value=$(<"$record")
  [[ $value == panel:"$site":* || $value == wordpress:"$site":* ]] || { echo 'database is not registered to this site' >&2; exit 1; }
  database_exists "$database" || { echo 'database does not exist' >&2; exit 1; }
  if [[ $engine == postgresql ]]; then
    runuser -u postgres -- psql --no-psqlrc --no-password --set ON_ERROR_STOP=1 --dbname "$database"
  else
    "$client" --no-defaults --protocol=socket --batch --binary-mode "$database"
  fi
  exit $?
fi

case "$action" in
  provision)
    (( $# == 5 )) || { echo 'usage: stepanel-dbctl provision DATABASE USER SITE ENCODING' >&2; exit 64; }
    db_user=$3; site=$4; encoding=$5
    if ! valid_user "$db_user" || ! valid_site "$site"; then echo 'invalid database user or site' >&2; exit 1; fi
    [[ $encoding =~ ^[A-Za-z0-9_-]{1,32}$ ]] || { echo 'invalid encoding' >&2; exit 1; }
    lock_resources "database-$database" "site-$site" "user-$db_user"
    IFS= read -r password; [[ $password =~ ^[A-Za-z0-9!@#%^*_=+.,:-]{20,128}$ ]] || { echo 'invalid database password' >&2; exit 1; }
    [[ ! -e $record ]] || { echo 'database ownership record already exists' >&2; exit 1; }
    database_exists "$database" && { echo 'database already exists' >&2; exit 1; }; user_exists "$db_user" && { echo 'database user already exists' >&2; exit 1; }
    register_database "$database" "pending-panel:$site:$db_user"
    cleanup_panel() { local exit_status=$?; trap - EXIT; if (( exit_status != 0 )); then drop_objects "$database" "$db_user" >/dev/null 2>&1 || true; remove_record "$record"; fi; exit "$exit_status"; }
    trap cleanup_panel EXIT
    if [[ $engine == postgresql ]]; then
      sql_secret "CREATE ROLE \"$db_user\" LOGIN PASSWORD '$password' NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION CONNECTION LIMIT 20"
      sql "CREATE DATABASE \"$database\" OWNER \"$db_user\" ENCODING '$encoding' TEMPLATE template0"
    else
      sql "CREATE DATABASE \`$database\` CHARACTER SET $encoding"
      sql_secret "CREATE USER '$db_user'@'localhost' IDENTIFIED BY '$password'"
      sql "GRANT ALL PRIVILEGES ON \`$database\`.* TO '$db_user'@'localhost'"
    fi
    register_database "$database" "panel:$site:$db_user"
    ;;
  rotate)
    (( $# == 3 )) || { echo 'usage: stepanel-dbctl rotate DATABASE USER' >&2; exit 64; }; db_user=$3; valid_user "$db_user" || exit 1
    lock_resources "database-$database" "user-$db_user"
    [[ -f $record ]] || { echo 'database is not registered to this user' >&2; exit 1; }; value=$(<"$record")
    [[ $value == panel:*:"$db_user" || $value == wordpress:*:"$db_user" || $value == "wordpress:$db_user" ]] || { echo 'database is not registered to this user' >&2; exit 1; }
    IFS= read -r password; [[ $password =~ ^[A-Za-z0-9!@#%^*_=+.,:-]{20,128}$ ]] || exit 1
    if [[ $engine == postgresql ]]; then sql_secret "ALTER ROLE \"$db_user\" PASSWORD '$password'"; else sql_secret "ALTER USER '$db_user'@'localhost' IDENTIFIED BY '$password'"; fi
    ;;
  drop-managed)
    (( $# == 3 )) || exit 64; db_user=$3; valid_user "$db_user" || exit 1
    lock_resources "database-$database" "user-$db_user"
    [[ -f $record ]] || { echo 'database is not registered to this user' >&2; exit 1; }; value=$(<"$record")
    [[ $value == panel:*:"$db_user" || $value == wordpress:*:"$db_user" || $value == "wordpress:$db_user" ]] || { echo 'database is not registered to this user' >&2; exit 1; }
    drop_objects "$database" "$db_user"; remove_record "$record"
    ;;
  restore)
    [[ $engine != postgresql ]] || { echo 'cPanel restore is unavailable for PostgreSQL' >&2; exit 1; }; (( $# == 3 )) || exit 64
    site=$3; valid_site "$site" || exit 1
    lock_resources "database-$database" "site-$site"
    [[ ! -e $record ]] || exit 1; database_exists "$database" && exit 1
    importer="spi_$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')"; password=$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')
    cleanup_cpmove() { local exit_status=$?; trap - EXIT; sql "DROP USER IF EXISTS '$importer'@'localhost'" >/dev/null 2>&1 || true; if (( exit_status != 0 )); then sql "DROP DATABASE IF EXISTS \`$database\`" >/dev/null 2>&1 || true; remove_record "$record"; fi; exit "$exit_status"; }
    register_database "$database" "pending-cpmove:$site:$importer"; trap cleanup_cpmove EXIT
    sql "CREATE DATABASE \`$database\`"; sql_secret "CREATE USER '$importer'@'localhost' IDENTIFIED BY '$password'"; sql "GRANT ALL PRIVILEGES ON \`$database\`.* TO '$importer'@'localhost'"
    MYSQL_PWD="$password" "$client" --protocol=socket --user="$importer" "$database"; register_database "$database" "cpmove:$site"
    ;;
  restore-wordpress)
    [[ $engine != postgresql ]] || { echo 'WordPress restore is unavailable for PostgreSQL' >&2; exit 1; }; (( $# == 4 )) || exit 64
    db_user=$3; site=$4; if ! valid_user "$db_user" || ! valid_site "$site"; then exit 1; fi
    lock_resources "database-$database" "site-$site" "user-$db_user"
    IFS= read -r password
    [[ $password =~ ^[A-Za-z0-9!@#%^*_=+.,:-]{16,128}$ ]] || exit 1; [[ ! -e $record ]] || exit 1; database_exists "$database" && exit 1; user_exists "$db_user" && exit 1
    cleanup_wordpress() { local exit_status=$?; trap - EXIT; if (( exit_status != 0 )); then drop_objects "$database" "$db_user" >/dev/null 2>&1 || true; remove_record "$record"; fi; exit "$exit_status"; }
    register_database "$database" "pending-wordpress:$site:$db_user"; trap cleanup_wordpress EXIT
    sql "CREATE DATABASE \`$database\`"; sql_secret "CREATE USER '$db_user'@'localhost' IDENTIFIED BY '$password'"; sql "GRANT ALL PRIVILEGES ON \`$database\`.* TO '$db_user'@'localhost'"
    MYSQL_PWD="$password" "$client" --protocol=socket --user="$db_user" "$database"; register_database "$database" "wordpress:$site:$db_user"
    ;;
  cleanup-wordpress)
    (( $# == 3 )) || exit 64; db_user=$3; valid_user "$db_user" || exit 1
    lock_resources "database-$database" "user-$db_user"
    [[ -f $record ]] || exit 0; value=$(<"$record"); [[ $value == "wordpress:$db_user" || $value == wordpress:*:"$db_user" ]] || exit 1; drop_objects "$database" "$db_user"; remove_record "$record"
    ;;
  drop)
    (( $# == 2 )) || exit 64
    lock_resources "database-$database"
    [[ -f $record ]] || exit 0; value=$(<"$record"); [[ $value == cpmove || $value == cpmove:* ]] || exit 1
    if [[ $engine == postgresql ]]; then sql "DROP DATABASE IF EXISTS \"$database\""; else sql "DROP DATABASE IF EXISTS \`$database\`"; fi; remove_record "$record"
    ;;
  dump)
    (( $# == 2 )) || exit 64; [[ -f $record ]] || { echo 'database is not registered as managed' >&2; exit 1; }; [[ $(<"$record") != pending-* ]] || exit 1
    if [[ $engine == postgresql ]]; then runuser -u postgres -- pg_dump --no-password --format=plain --clean --if-exists --no-owner --no-privileges "$database"; else dump_client=mysqldump; command -v mariadb-dump >/dev/null 2>&1 && dump_client=mariadb-dump; "$dump_client" --no-defaults --protocol=socket --single-transaction --quick --routines --events --triggers --hex-blob "$database"; fi
    ;;
  *) echo 'usage: stepanel-dbctl reconcile|list|inventory|diagnostics|sessions|settings|terminate|provision|rotate|drop-managed|restore|restore-wordpress|cleanup-wordpress|drop|dump ...' >&2; exit 64 ;;
esac
