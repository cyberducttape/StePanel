#!/usr/bin/env bash
set -Eeuo pipefail

[[ $EUID -eq 0 ]] || { echo 'must run as root' >&2; exit 1; }
root=/usr/local/lsws/conf/vhosts/stepanel/sites
template=${STEPANEL_OLS_VHOST_TEMPLATE:-/etc/stepanel-ols-vhost.template}
lswsctrl=${LSWSCTRL:-/usr/local/lsws/bin/lswsctrl}
[[ -x "$lswsctrl" ]] || lswsctrl=$(command -v lswsctrl || true)
[[ -x "$lswsctrl" ]] || { echo 'OpenLiteSpeed control command not found' >&2; exit 1; }
[[ -r "$template" ]] || { echo "OpenLiteSpeed vhost template is required at $template" >&2; exit 78; }
template_mode=$(stat -c '%u %a' "$template" 2>/dev/null || true)
[[ $template_mode =~ ^0\ ([0-7]{3,4})$ ]] || { echo 'OpenLiteSpeed vhost template must be root-owned and not writable by group/other' >&2; exit 1; }
template_perm=${BASH_REMATCH[1]}
group_other=${template_perm: -2}
[[ $group_other != *[2367]* ]] || { echo 'OpenLiteSpeed vhost template must be root-owned and not writable by group/other' >&2; exit 1; }
install -d -m 0755 -o root -g root "$root"
exec 9>/run/lock/stepanel-ols.lock
flock -x 9
location_lib=/usr/local/lib/stepanel/site-location.sh
[[ -f $location_lib && ! -L $location_lib && $(stat -c '%u' -- "$location_lib") == 0 && $(( 8#$(stat -c '%a' -- "$location_lib") & 022 )) == 0 ]] || { echo 'site location library is missing or unsafe' >&2; exit 1; }
# shellcheck source=stepanel-site-location.sh
. "$location_lib"

valid_site() { [[ $1 =~ ^[a-z0-9_-]{1,32}$ ]]; }
valid_domain() { [[ $1 =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; }
render() {
  sed -e "s|{{SITE}}|$site|g" -e "s|{{DOMAIN}}|$domain|g" -e "s|{{ROOT}}|$public_root|g" "$template"
}
restart() { "$lswsctrl" restart >/dev/null; }

case "${1:-}" in
  apply)
    (( $# == 3 )) || { echo 'usage: stepanel-ols-vhostctl apply SITE DOMAIN' >&2; exit 64; }
    site=$2; domain=${3,,}; valid_site "$site" || { echo 'invalid site' >&2; exit 1; }; valid_domain "$domain" || { echo 'invalid domain' >&2; exit 1; }
    # Sets public_root for a legacy or hosting-account site (ADR-0007).
    stepanel_site_location "$site" || exit 1
    [[ -d "$public_root" && ! -L "$public_root" ]] || { echo 'site document root is unavailable or unsafe' >&2; exit 1; }
    path="$root/site-${site}-${domain//./_}.conf"; tmp=$(mktemp "$root/.stepanel.XXXXXX"); backup=$(mktemp)
    existed=0; [[ ! -f "$path" ]] || { cp -p "$path" "$backup"; existed=1; }
    trap 'rm -f "$tmp" "$backup"' EXIT
    render > "$tmp"; chmod 0644 "$tmp"; chown root:root "$tmp"; mv -f "$tmp" "$path"
    if ! restart; then
      if (( existed )); then mv -f "$backup" "$path"; else rm -f "$path"; fi
      restart || true; exit 1
    fi
    ;;
  delete)
    (( $# == 2 )) || { echo 'usage: stepanel-ols-vhostctl delete NAME' >&2; exit 64; }
    [[ $2 =~ ^site-[a-z0-9_-]{1,32}-[a-z0-9_-]+\.conf$ ]] || { echo 'invalid vhost name' >&2; exit 1; }
    path="$root/$2"; [[ -f "$path" && ! -L "$path" ]] || { echo 'vhost not found or unsafe' >&2; exit 1; }
    backup=$(mktemp); cp -p "$path" "$backup"; rm -f "$path"
    if ! restart; then mv -f "$backup" "$path"; restart || true; exit 1; fi
    rm -f "$backup"
    ;;
  *) echo 'usage: stepanel-ols-vhostctl apply SITE DOMAIN | delete NAME' >&2; exit 64 ;;
esac
