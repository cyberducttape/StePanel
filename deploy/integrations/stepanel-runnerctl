#!/usr/bin/env bash
set -Eeuo pipefail
runner_owner_pid=$BASHPID
[[ $EUID -eq 0 ]] || { echo 'must run as root' >&2; exit 1; }
# Commands below run as the site account, which may not be able to enter the
# caller's working directory.
cd /
[[ $# -eq 10 && $1 == "build" ]] || { echo 'usage: stepanel-runnerctl build SITE IMAGE ROOT SCRIPT CPU_PERCENT MEMORY_MB TASKS_MAX NETWORK_MODE MAX_IMAGE_BYTES' >&2; exit 64; }
site=$2 image=$3 root=$4 script=$5 cpu_percent=$6 memory_mb=$7 tasks_max=$8 network_mode=$9 max_image_bytes=${10}
[[ $site =~ ^[a-z0-9_-]{1,32}$ && $image =~ ^[a-z0-9][a-z0-9._/-]{0,180}(:[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?@sha256:[0-9a-f]{64}$ && $cpu_percent =~ ^[0-9]+$ && $memory_mb =~ ^[0-9]+$ && $tasks_max =~ ^[0-9]+$ && $max_image_bytes =~ ^[0-9]+$ && $cpu_percent -ge 25 && $cpu_percent -le 6400 && $memory_mb -ge 64 && $memory_mb -le 1048576 && $tasks_max -ge 16 && $tasks_max -le 100000 && $max_image_bytes -gt 0 && ( $network_mode == "none" || $network_mode == "egress" ) && ( $root == "/var/www/sites/$site/public" || $root =~ ^/var/www/sites/$site/\.stepanel-release-[A-Za-z0-9-]+$ ) ]] || { echo 'invalid build request' >&2; exit 1; }
site_root="/var/www/sites/$site"
[[ -d $root && ! -L $root && -f $script && ! -L $script && -d "$site_root" && ! -L "$site_root" ]] || { echo 'invalid build inputs' >&2; exit 1; }
podman_bin=$(command -v podman) || { echo 'rootless Podman is required' >&2; exit 1; }
command -v systemd-run >/dev/null || { echo 'systemd-run is required for isolated runner execution' >&2; exit 1; }
hash=$(printf '%s' "$site" | sha256sum); hash=${hash%% *}; prefix=${site:0:18}; prefix=${prefix//_/-}; site_user="sp-${prefix}-${hash:0:8}"
id "$site_user" >/dev/null 2>&1 || { echo 'site user is unavailable' >&2; exit 1; }
site_uid=$(id -u "$site_user")
site_gid=$(id -g "$site_user")
for mapping_tool in newuidmap newgidmap; do
  command -v "$mapping_tool" >/dev/null || { echo "$mapping_tool is required for rootless Podman; install the host uidmap tools" >&2; exit 1; }
done
# Storage is pinned to the FUSE overlay driver below; fail with an actionable
# message here rather than an opaque Podman storage error mid-pull.
fuse_overlayfs=/usr/bin/fuse-overlayfs
[[ -x $fuse_overlayfs ]] || { echo "$fuse_overlayfs is required for rootless Podman storage; install fuse-overlayfs" >&2; exit 1; }
[[ $network_mode != egress ]] || command -v slirp4netns >/dev/null || { echo 'slirp4netns is required for egress builds' >&2; exit 1; }

# Site accounts are system users, so they commonly have no subordinate ID
# mappings. Allocate them only when they first request a container build.
# A single lock serializes StePanel's scan-and-allocate sequence across sites;
# usermod still performs the authoritative shadow-utils file update.
subid_lock=/run/stepanel-subid-allocation.lock
umask 0077
exec 9>"$subid_lock"
umask 0007
flock -x 9 || { echo 'could not lock subordinate ID allocation' >&2; exit 1; }
subid_source=$(awk '$1 == "subid:" { print $2; exit }' /etc/nsswitch.conf 2>/dev/null || true)
[[ -z $subid_source || $subid_source == files ]] || { echo 'rootless Podman requires file-backed subuid/subgid allocation' >&2; exit 1; }

login_def() {
  local key=$1 fallback=$2 value
  value=$(awk -v key="$key" '$1 == key && $2 ~ /^[0-9]+$/ { value=$2 } END { if (value != "") print value }' /etc/login.defs 2>/dev/null || true)
  printf '%s' "${value:-$fallback}"
}

ensure_subid_range() {
  local kind=$1 file min_key max_key count_key add_option min max count candidate last start length end
  case "$kind" in
    uid) file=/etc/subuid; min_key=SUB_UID_MIN; max_key=SUB_UID_MAX; count_key=SUB_UID_COUNT; add_option=-v ;;
    gid) file=/etc/subgid; min_key=SUB_GID_MIN; max_key=SUB_GID_MAX; count_key=SUB_GID_COUNT; add_option=-w ;;
    *) return 64 ;;
  esac
  if [[ -L $file || ( -e $file && ! -f $file ) ]]; then
    echo "$file is not a regular file" >&2
    return 1
  fi
  if [[ ! -e $file ]]; then
    (set -o noclobber; : > "$file") 2>/dev/null || true
    [[ -f $file && ! -L $file ]] || { echo "could not safely create $file" >&2; return 1; }
    chown root:root "$file"
    chmod 0644 "$file"
  fi
  if ! awk -F: 'NF == 0 || $1 ~ /^[[:space:]]*#/ { next } NF != 3 || $1 == "" || $2 !~ /^[0-9]+$/ || $3 !~ /^[0-9]+$/ || $3 < 1 { exit 1 }' "$file"; then
    echo "$file contains an invalid subordinate ID entry" >&2
    return 1
  fi
  min=$(login_def "$min_key" 100000)
  max=$(login_def "$max_key" 600100000)
  count=$(login_def "$count_key" 65536)
  [[ $min =~ ^[0-9]+$ && $max =~ ^[0-9]+$ && $count =~ ^[0-9]+$ && $count -gt 0 && $max -ge $min ]] || {
    echo "invalid $kind subordinate ID range in /etc/login.defs" >&2
    return 1
  }
  if awk -F: -v name="$site_user" -v uid="$site_uid" -v need="$count" \
    '($1 == name || $1 == uid) && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $3 >= need { found=1 } END { exit !found }' "$file"; then
    return 0
  fi

  candidate=$min
  while read -r start length; do
    [[ $start =~ ^[0-9]+$ && $length =~ ^[0-9]+$ && $length -gt 0 ]] || continue
    end=$((start + length - 1))
    (( end < candidate )) && continue
    if (( start > candidate && start - candidate >= count )); then
      break
    fi
    (( end >= candidate )) && candidate=$((end + 1))
  done < <(awk -F: '$2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $3 > 0 { print $2, $3 }' "$file" | LC_ALL=C sort -n -k1,1)

  last=$((candidate + count - 1))
  if (( last > max )); then
    echo "no free $kind subordinate ID range of $count IDs remains in $file" >&2
    return 1
  fi
  # usermod takes the shadow-utils passwd lock, which the broker may hold
  # briefly for an unrelated site's account mutation. Retry bounded contention
  # instead of failing the build; the subid lock above keeps the range ours.
  local attempt
  for attempt in 1 2 3 4 5; do
    usermod "$add_option" "$candidate-$last" "$site_user" && return 0
    (( attempt < 5 )) && sleep 2
  done
  echo "could not assign $kind subordinate IDs to $site_user" >&2
  return 1
}

ensure_subid_range uid || exit 1
ensure_subid_range gid || exit 1
flock -u 9
exec 9>&-
artifact="$site_root/.stepanel-artifact"
scratch=
source_copy=
build_artifact=
# Podman storage lives outside the web tree: under SELinux the site tree is
# web content, which the container runtime may not use for its database and
# layers. New directories under /var/lib/containers inherit the container
# storage label (container_var_lib_t) from the distribution policy.
runner_storage_root=/var/lib/containers/stepanel-runner
runner_home="$runner_storage_root/$site_user"
install -d -m 0711 -o root -g root /var/lib/containers "$runner_storage_root"
[[ -d $runner_home && ! -L $runner_home ]] || install -d -m 0700 -o "$site_user" -g "$site_user" "$runner_home"
[[ $(stat -c '%u:%g' -- "$runner_home") == "$site_uid:$site_gid" ]] || { echo 'runner storage has unexpected ownership' >&2; exit 1; }
runuser -u "$site_user" -- install -d -m 0700 "$runner_home/storage"

# Podman must run outside the broker's NoNewPrivileges and namespace
# restrictions: newuidmap/newgidmap need their narrowly scoped setuid
# transition. systemd starts a separate site-owned unit with explicit limits
# and a delegated cgroup subtree; the privileged broker itself remains fully
# restricted. The transient unit is tied to the broker and has a hard runtime
# limit so a killed broker cannot leave a build running indefinitely.
runner_unit=
runner_runtime=
runner_log_dir="/run/stepanel-runner-log-$runner_owner_pid"
install -d -m 0700 -o root -g root "$runner_log_dir"
cleanup_runner() {
  rm -rf -- "$runner_log_dir" 2>/dev/null || true
  if [[ -n ${runner_unit:-} ]]; then
    systemctl stop "$runner_unit" >/dev/null 2>&1 || true
  fi
  if [[ -n ${runner_runtime:-} ]]; then
    rm -rf -- "/run/$runner_runtime" 2>/dev/null || true
  fi
  if [[ -n ${scratch:-} ]]; then
    runuser -u "$site_user" -- rm -rf -- "$scratch" 2>/dev/null || true
  fi
  if [[ -n ${source_copy:-} ]]; then
    rm -rf -- "$source_copy" 2>/dev/null || true
  fi
  if [[ -n ${build_artifact:-} ]]; then
    runuser -u "$site_user" -- rm -rf -- "$build_artifact" 2>/dev/null || true
  fi
}
trap cleanup_runner EXIT

run_podman_as_site() {
  # Podman 5 records its run directories in the storage database on first use
  # and reuses them, so the runtime directory must be stable per site. Builds
  # for one site are serialized by the broker's site lock.
  runner_runtime="stepanel-runner-${site_user}"
  rm -rf -- "/run/$runner_runtime"
  runner_unit="stepanel-runner-${runner_owner_pid}.service"
  local memory_overhead=128 tasks_overhead=32
  # Rootless Podman may fail its native-overlay capability probe inside the
  # service sandbox before it can discover the FUSE fallback. Give each
  # invocation a controlled config outside the customer-writable site tree.
  # RuntimeDirectory= is created by systemd before the command starts, but
  # systemd-run keeps it root-owned by default. Podman needs both the runtime
  # directory itself and its runroot/events directory writable by the site
  # account, so create the complete tree with the same ownership before
  # starting the transient unit. Do not delegate this to RuntimeDirectory=;
  # its default root ownership is exactly what makes rootless Podman fail.
  # Podman validates XDG_RUNTIME_DIR itself, including the directory at the
  # exact path rather than only its children.  Do not rely on install(1)'s
  # ownership handling for intermediate directories: on some systemd/tmpfs
  # combinations the runtime root is created by another component and remains
  # root-owned even though the child paths are correct.
  install -d -m 0700 \
    "/run/$runner_runtime/containers" \
    "/run/$runner_runtime/config/containers"
  chown "$site_user:$site_user" \
    "/run/$runner_runtime" \
    "/run/$runner_runtime/containers" \
    "/run/$runner_runtime/config" \
    "/run/$runner_runtime/config/containers"
  chmod 0700 \
    "/run/$runner_runtime" \
    "/run/$runner_runtime/containers" \
    "/run/$runner_runtime/config" \
    "/run/$runner_runtime/config/containers"
  [[ $(stat -c '%u:%g' "/run/$runner_runtime") == "$(id -u "$site_user"):$(id -g "$site_user")" ]] || {
    echo "runtime directory is not owned by $site_user" >&2
    rm -rf -- "/run/$runner_runtime"
    runner_runtime=
    return 1
  }
  install -o "$site_user" -g "$site_user" -m 0600 /dev/null "/run/$runner_runtime/config/containers/storage.conf"
  printf '[storage]\ndriver = "overlay"\ngraphroot = "%s"\nrunroot = "%s"\n[storage.options.overlay]\nmount_program = "%s"\n' \
    "$runner_home/storage" "/run/$runner_runtime/containers" "$fuse_overlayfs" \
    > "/run/$runner_runtime/config/containers/storage.conf"
  [[ $(stat -c '%u:%g:%a' "/run/$runner_runtime/config/containers/storage.conf") == "$site_uid:$site_gid:600" ]] || {
    echo 'runner storage configuration has unexpected ownership or mode' >&2
    rm -rf -- "/run/$runner_runtime"
    runner_runtime=
    return 1
  }
  # slirp4netns needs the TUN device for egress builds; offline builds get
  # only /dev/fuse under the closed device policy.
  local device_args=(--property='DeviceAllow=/dev/fuse rw')
  [[ $network_mode == egress ]] && device_args+=(--property='DeviceAllow=/dev/net/tun rw')
  # Rootless Podman must create user, mount, network, PID, and UTS
  # namespaces. The transient unit is already constrained by its closed
  # device policy, protected host filesystems, and explicit resource limits;
  # denying namespace creation here makes every rootless pull fail before
  # the container can start.
  #
  # Options that make systemd set no_new_privs are deliberately absent
  # (ProtectKernelTunables/Modules/Logs, ProtectClock, RestrictRealtime,
  # RestrictAddressFamilies on systemd 252): no_new_privs stops newuidmap's
  # setuid transition and, under SELinux, podman's transition into
  # container_runtime_t ("avc: denied { nnp_transition }"), so no build could
  # start. The site account is unprivileged, and each container still runs
  # with all capabilities dropped, no-new-privileges, a read-only root,
  # seccomp, a user namespace, and (under SELinux) the container_t domain.
  #
  # The unit's output goes to a log in a root-owned directory instead of
  # systemd-run --pipe: handing a caller's pipes to PID 1 fails ("Connection
  # reset by peer") when systemd-run itself runs inside a system service, as
  # it does under the root broker. Root owns the log directory, so the site
  # account cannot plant a symlink for PID 1 to follow.
  local log="$runner_log_dir/$BASHPID-$RANDOM.log"
  if systemd-run --quiet --wait --collect --service-type=exec --unit="$runner_unit" \
    --property="StandardOutput=append:$log" --property="StandardError=append:$log" \
    --uid="$site_user" --gid="$site_user" --working-directory="$runner_home" \
    --setenv="HOME=$runner_home" --setenv="XDG_RUNTIME_DIR=/run/$runner_runtime" \
    --setenv="XDG_CONFIG_HOME=/run/$runner_runtime/config" \
    --setenv="CONTAINERS_STORAGE_CONF=/run/$runner_runtime/config/containers/storage.conf" \
    --property=NoNewPrivileges=no --property=RestrictSUIDSGID=no \
    --property=Delegate=yes --property=PartOf=stepanel-root-broker.service \
    --property=PrivateTmp=yes --property=DevicePolicy=closed "${device_args[@]}" --property=ProtectHome=yes \
    --property=ProtectSystem=strict --property="ReadWritePaths=$site_root" \
    --property="ReadWritePaths=$runner_home" --property="ReadWritePaths=-$runner_storage_root/src-$site_user" \
    --property=ProtectProc=invisible \
    --property=CPUQuota="${cpu_percent}%" \
    --property=MemoryMax="$((memory_mb + memory_overhead))M" \
    --property=TasksMax="$((tasks_max + tasks_overhead))" \
    --property="ReadWritePaths=/run/$runner_runtime" \
    --property=RuntimeMaxSec=30min --property=TimeoutStopSec=5s \
    -- "$podman_bin" --cgroup-manager=cgroupfs "${@:2}"; then
    local status=0
  else
    local status=$?
  fi
  if [[ -f $log ]]; then
    cat -- "$log"
    rm -f -- "$log"
  fi
  # systemd removes RuntimeDirectory= on stop, but not when systemd-run fails
  # before the unit starts. This may run in a command-substitution subshell,
  # whose EXIT trap does not fire, so clean up explicitly.
  rm -rf -- "/run/$runner_runtime"
  runner_unit=
  runner_runtime=
  return "$status"
}

# Pull the immutable digest before execution so the size gate cannot be
# bypassed by a first-use pull during `podman run`. Preserve the bounded
# systemd/Podman diagnostic; otherwise a transient-unit failure is reported
# only as an opaque exit status to the caller.
if ! pull_output=$(run_podman_as_site "$podman_bin" pull "$image" 2>&1); then
  echo "container image pull failed:" >&2
  printf '%s\n' "$pull_output" >&2
  exit 1
fi
if ! image_inspect_output=$(run_podman_as_site "$podman_bin" image inspect --format '{{.Size}}' "$image" 2>&1); then
  echo "container image inspection failed:" >&2
  printf '%s\n' "$image_inspect_output" >&2
  exit 1
fi
# Podman may print warnings (for example about the pause process's systemd
# cgroup) on stderr, which the transient unit pipes with stdout; the size is
# the numeric line.
image_size=$(printf '%s\n' "$image_inspect_output" | awk '/^[0-9]+$/ { size = $0 } END { print size }')
[[ $image_size =~ ^[0-9]+$ && $image_size -le $max_image_bytes ]] || { echo "container image exceeds configured size limit ($max_image_bytes bytes)" >&2; exit 1; }
# Keep all customer-tree mutation under the site account. Root validates the
# final directory but never recursively deletes a customer-controlled path.
#
# Each build writes a fresh directory. It replaces .stepanel-artifact only
# after the build succeeds, so a failed build leaves the last good artifact
# intact. Build directories orphaned by a killed run are removed first.
runuser -u "$site_user" -- find -P "$site_root" -mindepth 1 -maxdepth 1 -name '.stepanel-build.*' -mmin +60 -exec rm -rf -- {} +
build_artifact=$(runuser -u "$site_user" -- mktemp -d "$site_root/.stepanel-build.XXXXXXXX")
# mktemp creates 0700, which also sets the ACL mask to ---; the panel must be
# able to validate and publish the artifact through its ACL entry. Symbolic
# modes keep the setgid bit inherited from the site root.
runuser -u "$site_user" -- chmod u=rwx,g=rx,o= -- "$build_artifact"
[[ $build_artifact == "$site_root"/.stepanel-build.* && -d $build_artifact && ! -L $build_artifact ]] || { echo 'build directory is not a directory' >&2; exit 1; }
build_uid=$(stat -c '%u' -- "$build_artifact")
build_gid=$(stat -c '%g' -- "$build_artifact")
# Sealed site roots are setgid to the web group, so directories the site
# account creates there inherit that group; ownership by the site account is
# what matters.
site_root_gid=$(stat -c '%g' -- "$site_root")
[[ $build_uid == "$site_uid" && ( $build_gid == "$site_gid" || $build_gid == "$site_root_gid" ) ]] || { echo 'build directory has unexpected ownership' >&2; exit 1; }
# The submitted script lives in STEPANEL_APP_ROOT, which is owned by the
# stepanel service account (0750/0600). The isolated sp-* site account that
# rootless Podman drops to is not in that group and cannot traverse into
# stepanel's data dir or read a 0600 stepanel:stepanel file, so bind-mounting
# the submitted path directly would fail with EACCES inside the container.
# Copy the contents into a site-owned scratch path first and bind-mount that.
scratch="$site_root/.stepanel-runner-scratch"
runuser -u "$site_user" -- install -d -m 0700 "$scratch"
# The EXIT trap (cleanup_runner) destroys the site-owned scratch tree on any
# exit after this point, including mid-setup failures. Deletion runs as the site account, so no root
# rm -rf ever touches a customer path.
scratch_uid=$(stat -c '%u' -- "$scratch")
scratch_gid=$(stat -c '%g' -- "$scratch")
[[ $scratch_uid == "$site_uid" && ( $scratch_gid == "$site_gid" || $scratch_gid == "$site_root_gid" ) ]] || { echo 'scratch directory has unexpected ownership' >&2; exit 1; }
build_script="$scratch/build.sh"
# Create the file writable, stream contents in as the site account, then drop
# write on it. 0500 = r-x for owner only, matching the container's read-only
# mount and preventing accidental in-place mutation.
runuser -u "$site_user" -- install -m 0600 /dev/null "$build_script"
cat -- "$script" | runuser -u "$site_user" -- tee "$build_script" >/dev/null
runuser -u "$site_user" -- chmod 0500 "$build_script"
# Build from a copy of the source. The container mounts use :Z so SELinux
# gives them a private container label; mounting the live document root (or
# a release about to be published) that way would relabel served files and
# lock the web server out of them.
#
# Root makes the copy because a release staged by the panel is private to the
# panel account. It copies into a root-owned directory (never into a path the
# site account controls, which could be swapped for a symlink), without
# following links, and then hands the copy to the site account without
# following links either.
source_copy="$runner_storage_root/src-$site_user"
rm -rf -- "$source_copy"
install -d -m 0700 -o root -g root "$source_copy"
cp -a --reflink=auto --no-preserve=ownership -- "$root/." "$source_copy/"
chown -R -h -- "$site_user:$site_user" "$source_copy"
cpus=$(awk "BEGIN { printf \"%.2f\", $cpu_percent / 100 }")
# Convert network_mode to podman flag: "none" -> "--network none", "egress" -> "--network slirp4netns"
network_args=(--network none)
[[ $network_mode == "egress" ]] && network_args=(--network slirp4netns)
build_status=0
run_podman_as_site "$podman_bin" run --rm "${network_args[@]}" --userns keep-id --cap-drop ALL --security-opt no-new-privileges --read-only --cpus "$cpus" --memory "${memory_mb}m" --pids-limit "$tasks_max" --tmpfs /tmp:rw,noexec,nosuid,size=512m -v "$source_copy:/src:ro,Z" -v "$build_artifact:/artifact:rw,Z" -v "$build_script:/run/stepanel/build.sh:ro,Z" -w /src "$image" /bin/sh /run/stepanel/build.sh || build_status=$?
if (( build_status != 0 )); then
  # The build directory is discarded by the EXIT trap; the previous artifact
  # is untouched.
  echo "sandboxed build exited with status $build_status" >&2
  df -P -- "$site_root" "$runner_home" 2>&1 || true
  if command -v quota >/dev/null 2>&1; then
    quota -u "$site_user" 2>&1 || true
  fi
  stat -c 'build_artifact=%n mode=%a owner=%u:%g' -- "$build_artifact" 2>&1 || true
  exit "$build_status"
fi
# The build directory was relabelled for the container; restore the site
# tree's labels before it is validated and published, or the web server would
# be denied the activated release. restorecon relabels without following links
# and -x keeps it on this filesystem.
if command -v selinuxenabled >/dev/null 2>&1 && selinuxenabled && command -v restorecon >/dev/null 2>&1; then
  restorecon -R -F -x -- "$build_artifact" || { echo 'could not restore SELinux labels on the build artifact' >&2; exit 1; }
fi
# Promote the successful build. Renames run as the site account inside its own
# tree; the superseded artifact is deleted only after the new one is in place.
superseded=
if [[ -e $artifact || -L $artifact ]]; then
  superseded="$build_artifact.superseded"
  runuser -u "$site_user" -- mv -T -- "$artifact" "$superseded"
fi
runuser -u "$site_user" -- mv -T -- "$build_artifact" "$artifact"
build_artifact=
[[ -z $superseded ]] || runuser -u "$site_user" -- rm -rf -- "$superseded"
exit 0
