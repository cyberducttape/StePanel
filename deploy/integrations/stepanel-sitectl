#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $EUID -ne 0 ]]; then echo 'must run as root' >&2; exit 1; fi
action=$1
site=$2
[[ $site =~ ^[a-z0-9_-]{1,32}$ ]] || { echo 'invalid site' >&2; exit 1; }
[[ $action == prepare || $action == prepare-root || $action == seal || $action == delete || $action == runtime || $action == resources || $action == quota || $action == quota-clear || $action == access || $action == ftp ]] || { echo 'invalid action' >&2; exit 64; }

# Production always supplies the persisted identity as argv[3]. The old
# direct-helper shape is retained only for explicitly unsafe lab smoke
# scripts; it is never accepted by the installed production broker path.
legacy_shape=0
case "$action:$#" in
  prepare:2|prepare-root:2|seal:2|delete:2|access:4|ftp:3|runtime:11|resources:3|quota:4|quota-clear:2) legacy_shape=1 ;;
esac
if (( legacy_shape )); then
  [[ ${STEPANEL_UNSAFE_LAB:-0} == 1 ]] || { echo 'persisted site Unix account is required' >&2; exit 1; }
  hash=$(printf '%s' "$site" | sha256sum); hash=${hash%% *}
  prefix=${site:0:18}; prefix=${prefix//_/-}
  site_user="sp-${prefix}-${hash:0:8}"
  set -- "$1" "$2" "$site_user" "${@:3}"
fi
(( $# == 3 || $# == 4 || $# == 5 || $# == 12 )) || { echo 'usage: stepanel-sitectl prepare|prepare-root|seal SITE SITE_USER | resources SITE SITE_USER PHP_WORKERS | ftp SITE SITE_USER ENABLE | quota SITE SITE_USER DISK_MB INODES | quota-clear SITE SITE_USER | runtime SITE SITE_USER VERSION MEMORY EXEC UPLOAD POST INPUT OPCACHE DISPLAY ERROR' >&2; exit 64; }

web_group_config=/etc/ste-panel.env
[[ -f $web_group_config && ! -L $web_group_config ]] || { echo 'authoritative web group configuration is unavailable' >&2; exit 1; }
[[ $(stat -c %u "$web_group_config") == 0 && $(( 8#$(stat -c %a "$web_group_config") & 077 )) == 0 ]] || { echo 'authoritative web group configuration is not root-owned and private' >&2; exit 1; }
web_group=$(sed -n 's/^STEPANEL_WEB_GROUP="\([a-z_][a-z0-9_-]*\)"$/\1/p' "$web_group_config")
socket_root=$(sed -n 's/^STEPANEL_PHP_SOCKET_ROOT="\(\/[^"[:space:]]*\)"$/\1/p' "$web_group_config")
[[ $web_group =~ ^[a-z_][a-z0-9_-]*$ && $socket_root == /* && $socket_root != *$'\n'* && $socket_root != *$'\r'* && $socket_root != *' '* ]] || { echo 'authoritative web identity configuration is invalid' >&2; exit 1; }
getent group "$web_group" >/dev/null || { echo "configured web server group $web_group does not exist" >&2; exit 1; }
if [[ ! -d $socket_root ]]; then
  [[ ! -e $socket_root ]] || { echo "PHP socket root $socket_root is unavailable" >&2; exit 1; }
  install -d -m 0755 "$socket_root"
fi

site_user=$3
[[ $site_user =~ ^sp-[a-z0-9][a-z0-9-]{1,28}$ ]] || { echo 'invalid persisted site Unix account' >&2; exit 1; }
site_root="/var/www/sites/$site"
public_root="$site_root/public"
php_state="$site_root/.php"

if [[ $action == delete ]]; then
  [[ $# == 3 ]] || { echo 'usage: stepanel-sitectl delete SITE SITE_USER' >&2; exit 64; }
  if id "$site_user" >/dev/null 2>&1; then
    existing_home=$(getent passwd "$site_user" | cut -d: -f6)
    [[ $existing_home == "$site_root" ]] || { echo "refusing site deletion: account $site_user belongs to a different site" >&2; exit 1; }
    for pool in /etc/php/*/fpm/pool.d/stepanel-"$site".conf /etc/php-fpm.d/stepanel-"$site".conf; do
      [[ -e $pool && ! -L $pool ]] || continue
      rm -f "$pool"
    done
    rm -f "/etc/stepanel/ssh/authorized_keys/$site_user" "/etc/ssh/sshd_config.d/stepanel-$site_user.conf" "/etc/ssh/sshd_config.d/stepanel-ftp-$site_user.conf"
    ftp_userlist=/etc/vsftpd/stepanel.users
    if [[ -f $ftp_userlist && ! -L $ftp_userlist ]] && grep -Fxq -- "$site_user" "$ftp_userlist"; then
      list_staged=$(mktemp /etc/vsftpd/.users.XXXXXX)
      awk -v user="$site_user" '$0 != user { print }' "$ftp_userlist" > "$list_staged"
      chown root:root "$list_staged"; chmod 0600 "$list_staged"; mv -f "$list_staged" "$ftp_userlist"
    fi
    for unit in $(systemctl list-unit-files --type=service --no-legend 'php*-fpm.service' 'php-fpm.service' 2>/dev/null | awk '{print $1}'); do
      systemctl reload "$unit" 2>/dev/null || true
    done
    userdel_needed=1
  fi
  # Remove the tree even when the site user is gone (an imported recovery
  # site, or a retry after a partial teardown): it can hold root-owned state
  # such as the PHP session directory that the unprivileged panel cannot
  # remove. Remove it before the user so a failure leaves the user for a retry.
  if [[ -d $site_root && ! -L $site_root ]]; then
    rm -rf --one-file-system -- "$site_root"
  fi
  if [[ ${userdel_needed:-0} == 1 ]]; then
    userdel "$site_user" 2>/dev/null || true
  fi
  systemctl reload sshd 2>/dev/null || systemctl reload ssh 2>/dev/null || true
  exit 0
fi

ensure_site_user() {
  local attempt output
  for (( attempt = 1; attempt <= 20; attempt++ )); do
    if id "$site_user" >/dev/null 2>&1; then
      existing_home=$(getent passwd "$site_user" | cut -d: -f6)
      [[ $existing_home == "$site_root" ]] || { echo "account $site_user is already assigned to a different site" >&2; return 1; }
      return 0
    fi
    output=$(useradd --system --home-dir "$site_root" --shell /usr/sbin/nologin --user-group "$site_user" 2>&1) && return 0
    if [[ "$output" != *"cannot lock /etc/passwd"* && "$output" != *"cannot lock /etc/group"* ]]; then
      printf '%s\n' "$output" >&2
      return 1
    fi
    # useradd serializes through the system account database. A package
    # transaction or another host integration may briefly hold that lock;
    # retry only this known transient failure rather than turning a short
    # overlap into a failed site operation.
    sleep 0.25
  done
  printf '%s\n' "$output" >&2
  return 1
}

ensure_site_user
[[ -d /var/www/sites && ! -L /var/www/sites ]] || { echo 'shared site root is missing or unsafe' >&2; exit 1; }
chmod 2711 /var/www/sites
# prepare-root applies the full isolation contract except creating the
# public tree, which the panel publishes through the site manager's staged
# activation (cPanel import, archive import, restore).
if [[ $action == prepare-root ]]; then
  install -d -m 2750 -o "$site_user" -g "$web_group" "$site_root"
  action=prepare
else
  install -d -m 2750 -o "$site_user" -g "$web_group" "$site_root" "$public_root"
fi
install -d -m 0750 -o "$site_user" -g "$web_group" "$php_state" "$php_state/sessions" "$php_state/tmp"

# FTPS and SSH/SFTP key access share the account's password field. It holds
# the FTPS password while FTPS is enabled, otherwise a random hash nobody
# knows while SSH/SFTP keys are installed (public-key login needs an unlocked
# account), and is locked when neither is enabled. sshd password login stays
# disabled for the account in every state.
ftp_userlist=/etc/vsftpd/stepanel.users
ssh_authorized_keys="/etc/stepanel/ssh/authorized_keys/$site_user"
ftps_enabled_for_site() { [[ -f $ftp_userlist && ! -L $ftp_userlist ]] && grep -Fxq -- "$site_user" "$ftp_userlist"; }
ssh_keys_enabled_for_site() { [[ -s $ssh_authorized_keys && ! -L $ssh_authorized_keys ]]; }
set_unknown_password() {
  local hash
  command -v openssl >/dev/null 2>&1 || { echo 'openssl is required to unlock the site account' >&2; return 1; }
  hash=$(openssl passwd -6 -stdin <<< "$(openssl rand -base64 48)") || return 1
  usermod --password "$hash" "$site_user"
}

if [[ $action == access ]]; then
  (( $# == 5 )) || { echo 'usage: stepanel-sitectl access SITE SITE_USER SFTP SHELL' >&2; exit 64; }
  sftp=$4; shell=$5
  [[ $sftp =~ ^[01]$ && $shell =~ ^[01]$ ]] || { echo 'invalid SSH access policy' >&2; exit 1; }
  ssh_key_root=/etc/stepanel/ssh/authorized_keys
  ssh_config_root=/etc/ssh/sshd_config.d
  authorized_keys="$ssh_key_root/$site_user"
  ssh_config="$ssh_config_root/stepanel-$site_user.conf"
  # sshd must traverse this root-owned directory while looking up a user's
  # key. The files remain root-owned and non-writable by customers.
  install -d -m 0755 -o root -g root "$ssh_key_root"
  install -d -m 0755 -o root -g root "$ssh_config_root"
  staged=$(mktemp "$ssh_key_root/.authorized_keys.XXXXXX")
  forced=
  cleanup_access() { rm -f "$staged" "${forced:-}"; }
  trap cleanup_access EXIT
  cat > "$staged"
  if [[ $sftp == 1 || $shell == 1 ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
      [[ -n $line && ${#line} -le 8192 && $line != *$'\r'* ]] || { echo 'invalid SSH key line' >&2; exit 1; }
      [[ $line =~ ^(ssh-ed25519|ecdsa-sha2-nistp256|ecdsa-sha2-nistp384|ecdsa-sha2-nistp521|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com|ssh-rsa|rsa-sha2-256|rsa-sha2-512)[[:space:]]+[A-Za-z0-9+/]+={0,3}([[:space:]].*)?$ ]] || { echo 'invalid SSH public key input' >&2; exit 1; }
    done < "$staged"
    if ! ssh-keygen -lf "$staged" >/dev/null 2>&1; then
      echo 'SSH public key input failed host validation' >&2
      exit 1
    fi
  else
    : > "$staged"
  fi
  if [[ $sftp == 1 && $shell == 0 && -s $staged ]]; then
    # Keep root-generated authorization material outside the customer tree.
    # The site root is intentionally writable by its account, so it is not a
    # safe location for a privileged staging file.
    forced=$(mktemp "$ssh_key_root/.forced_keys.XXXXXX")
    while IFS= read -r line; do printf 'restrict,command="internal-sftp" %s\n' "$line"; done < "$staged" > "$forced"
    chown root:root "$forced"; chmod 0644 "$forced"; mv -f "$forced" "$staged"
    if ! ssh-keygen -lf "$staged" >/dev/null 2>&1; then
      echo 'generated SFTP-only SSH policy failed host validation' >&2
      exit 1
    fi
  fi
  chown root:root "$staged"
  chmod 0644 "$staged"
  key_backup=$(mktemp)
  config_backup=$(mktemp)
  key_existed=0; config_existed=0
  old_shell=$(getent passwd "$site_user" | cut -d: -f7)
  old_shadow=$(getent shadow "$site_user" | cut -d: -f2)
  if [[ -f $authorized_keys ]]; then cp -p "$authorized_keys" "$key_backup"; key_existed=1; fi
  if [[ -f $ssh_config ]]; then cp -p "$ssh_config" "$config_backup"; config_existed=1; fi
  restore_access() {
    if (( key_existed )); then mv -f "$key_backup" "$authorized_keys"; else rm -f "$authorized_keys"; fi
    if (( config_existed )); then mv -f "$config_backup" "$ssh_config"; else rm -f "$ssh_config"; fi
    usermod --shell "$old_shell" "$site_user" 2>/dev/null || true
    usermod --password "$old_shadow" "$site_user" 2>/dev/null || true
    systemctl reload sshd 2>/dev/null || systemctl reload ssh 2>/dev/null || true
    rm -f "$key_backup" "$config_backup"
  }
  if [[ $shell == 1 ]]; then
    usermod --shell /bin/bash "$site_user" || { restore_access; echo 'could not enable the site shell' >&2; exit 1; }
  else
    usermod --shell /usr/sbin/nologin "$site_user" || { restore_access; echo 'could not disable the site shell' >&2; exit 1; }
  fi
  if [[ $sftp == 1 || $shell == 1 ]]; then
    # System accounts are created locked. Public-key SSH/SFTP access still
    # requires an unlocked account. RHEL-family usermod rejects an empty
    # password field, so install a random hash that is not known to anyone,
    # unless FTPS already unlocked the account with its own password.
    if ! ftps_enabled_for_site; then
      set_unknown_password || { restore_access; echo 'could not enable the SSH/SFTP account' >&2; exit 1; }
    fi
    command -v sshd >/dev/null 2>&1 || { restore_access; echo 'sshd is required for SSH access management' >&2; exit 1; }
    mv -f "$staged" "$authorized_keys"
    cat > "$ssh_config" <<EOF
# Managed by StePanel. Do not edit.
Match User $site_user
    AuthorizedKeysFile $authorized_keys
    PasswordAuthentication no
    KbdInteractiveAuthentication no
EOF
    chmod 0644 "$authorized_keys" "$ssh_config"
    chown root:root "$authorized_keys" "$ssh_config"
    if ! sshd -t; then
      restore_access
      echo 'sshd rejected the StePanel access policy' >&2
      exit 1
    fi
    if ! (systemctl reload sshd 2>/dev/null || systemctl reload ssh 2>/dev/null); then
      restore_access
      echo 'could not reload sshd after applying access policy' >&2
      exit 1
    fi
  else
    if ! ftps_enabled_for_site; then
      usermod --lock "$site_user" || { restore_access; echo 'could not lock the SSH/SFTP account' >&2; exit 1; }
    fi
    rm -f "$authorized_keys" "$ssh_config" "$staged"
    if (( key_existed || config_existed )); then
      if ! (command -v sshd >/dev/null 2>&1 && sshd -t && (systemctl reload sshd 2>/dev/null || systemctl reload ssh 2>/dev/null)); then
        restore_access
        echo 'could not reload sshd after revoking access policy' >&2
        exit 1
      fi
    fi
  fi
  rm -f "$key_backup" "$config_backup"
  exit 0
fi

if [[ $action == ftp ]]; then
  (( $# == 4 )) || { echo 'usage: stepanel-sitectl ftp SITE SITE_USER ENABLE' >&2; exit 64; }
  ftp_enabled=$4
  [[ $ftp_enabled =~ ^[01]$ ]] || { echo 'invalid FTPS policy' >&2; exit 1; }
  ftp_config=/etc/vsftpd.conf
  [[ -f $ftp_config ]] || ftp_config=/etc/vsftpd/vsftpd.conf
  [[ -f $ftp_config && ! -L $ftp_config ]] || { echo 'vsftpd is not installed or configured' >&2; exit 1; }
  command -v chpasswd >/dev/null 2>&1 || { echo 'chpasswd is required for FTPS provisioning' >&2; exit 1; }
  command -v sshd >/dev/null 2>&1 || { echo 'sshd is required to enforce FTPS SSH password isolation' >&2; exit 1; }
  password=
  if [[ $ftp_enabled == 1 ]]; then
    password=$(cat)
    [[ ${#password} -ge 12 && ${#password} -le 128 && $password != *$'\r'* && $password != *$'\n'* ]] || { echo 'FTPS password must be 12-128 characters without control bytes' >&2; exit 1; }
  fi
  install -d -m 0750 -o root -g root /etc/vsftpd
  [[ ! -e $ftp_userlist || ! -L $ftp_userlist ]] || { echo 'FTPS user allowlist is unsafe' >&2; exit 1; }
  [[ -f $ftp_userlist ]] || : > "$ftp_userlist"
  chmod 0600 "$ftp_userlist"; chown root:root "$ftp_userlist"
  ftp_ssh_config="/etc/ssh/sshd_config.d/stepanel-ftp-$site_user.conf"
  install -d -m 0755 -o root -g root /etc/ssh/sshd_config.d
  list_backup=$(mktemp); config_backup=$(mktemp); list_staged=; ssh_staged=
  cp -p "$ftp_userlist" "$list_backup"
  config_existed=0
  if [[ -f $ftp_ssh_config ]]; then cp -p "$ftp_ssh_config" "$config_backup"; config_existed=1; fi
  old_shadow=$(getent shadow "$site_user" | cut -d: -f2)
  ftp_committed=0
  # Every exit before the commit point, including explicit `exit 1` paths that
  # an ERR trap would miss, restores the allowlist, password and sshd policy.
  finish_ftp() {
    if (( ! ftp_committed )); then
      cp -p "$list_backup" "$ftp_userlist" 2>/dev/null || true
      [[ -z $old_shadow ]] || usermod --password "$old_shadow" "$site_user" 2>/dev/null || true
      if (( config_existed )); then cp -p "$config_backup" "$ftp_ssh_config" 2>/dev/null || true; else rm -f "$ftp_ssh_config"; fi
      systemctl reload sshd 2>/dev/null || systemctl reload ssh 2>/dev/null || true
    fi
    rm -f "$list_backup" "$config_backup" "${list_staged:-}" "${ssh_staged:-}"
  }
  trap finish_ftp EXIT
  list_staged=$(mktemp /etc/vsftpd/.users.XXXXXX)
  awk -v user="$site_user" '$0 != user { print }' "$ftp_userlist" > "$list_staged"
  if [[ $ftp_enabled == 1 ]]; then
    printf '%s:%s\n' "$site_user" "$password" | chpasswd || { echo 'could not set the FTPS password' >&2; exit 1; }
    printf '%s\n' "$site_user" >> "$list_staged"
    ssh_staged=$(mktemp /etc/ssh/sshd_config.d/.stepanel-ftp.XXXXXX)
    printf '# Managed by StePanel. Do not edit.\nMatch User %s\n    PasswordAuthentication no\n    KbdInteractiveAuthentication no\n' "$site_user" > "$ssh_staged"
    chown root:root "$ssh_staged"; chmod 0644 "$ssh_staged"; mv -f "$ssh_staged" "$ftp_ssh_config"; ssh_staged=
  else
    # Revoking FTPS discards its password but must not lock out installed
    # SSH/SFTP keys, which need the account unlocked.
    if ssh_keys_enabled_for_site; then
      set_unknown_password || { echo 'could not revoke the FTPS password' >&2; exit 1; }
    else
      usermod --lock "$site_user" >/dev/null || { echo 'could not lock the site account' >&2; exit 1; }
    fi
    rm -f "$ftp_ssh_config"
  fi
  sshd -t || { echo 'sshd rejected the FTPS SSH password isolation policy' >&2; exit 1; }
  systemctl reload sshd 2>/dev/null || systemctl reload ssh 2>/dev/null || { echo 'could not reload sshd after FTPS policy change' >&2; exit 1; }
  chown root:root "$list_staged"; chmod 0600 "$list_staged"
  mv -f "$list_staged" "$ftp_userlist" || { echo 'could not publish the FTPS user allowlist' >&2; exit 1; }
  list_staged=
  ftp_committed=1
  exit 0
fi

profile="$php_state/runtime.env"
php_version=""
memory_limit=128M
max_execution_time=60
upload_max_filesize=32M
post_max_size=32M
max_input_vars=1000
opcache_enabled=1
display_errors=0
error_reporting='E_ALL & ~E_DEPRECATED & ~E_STRICT'

parse_config_file() {
  local filepath=$1
  if [[ ! -f $filepath ]] || [[ -L $filepath ]]; then
    return 0
  fi
  local line key value
  while IFS='=' read -r key value || [[ -n $key ]]; do
    [[ -z $key || $key =~ ^# ]] && continue
    case "$key" in
      php_version)
        [[ $value =~ ^[0-9]+\.[0-9]+$ ]] || { echo "invalid php_version in $filepath: $value" >&2; return 1; }
        php_version="$value"
        ;;
      memory_limit)
        [[ $value =~ ^[1-9][0-9]{0,4}M$ ]] || { echo "invalid memory_limit in $filepath: $value" >&2; return 1; }
        memory_limit="$value"
        ;;
      max_execution_time)
        [[ $value =~ ^[1-9][0-9]{0,4}$ ]] || { echo "invalid max_execution_time in $filepath: $value" >&2; return 1; }
        max_execution_time="$value"
        ;;
      upload_max_filesize)
        [[ $value =~ ^[1-9][0-9]{0,4}M$ ]] || { echo "invalid upload_max_filesize in $filepath: $value" >&2; return 1; }
        upload_max_filesize="$value"
        ;;
      post_max_size)
        [[ $value =~ ^[1-9][0-9]{0,4}M$ ]] || { echo "invalid post_max_size in $filepath: $value" >&2; return 1; }
        post_max_size="$value"
        ;;
      max_input_vars)
        [[ $value =~ ^[1-9][0-9]{0,6}$ ]] || { echo "invalid max_input_vars in $filepath: $value" >&2; return 1; }
        max_input_vars="$value"
        ;;
      opcache_enabled)
        [[ $value =~ ^[01]$ ]] || { echo "invalid opcache_enabled in $filepath: $value" >&2; return 1; }
        opcache_enabled="$value"
        ;;
      display_errors)
        [[ $value =~ ^[01]$ ]] || { echo "invalid display_errors in $filepath: $value" >&2; return 1; }
        display_errors="$value"
        ;;
      error_reporting)
        [[ $value =~ ^[A-Z0-9_~\ \&\|]{1,80}$ ]] || { echo "invalid error_reporting in $filepath: $value" >&2; return 1; }
        error_reporting="$value"
        ;;
      php_max_children)
        [[ $value =~ ^[0-9]+$ ]] && (( value >= 1 && value <= 512 )) || { echo "invalid php_max_children in $filepath: $value" >&2; return 1; }
        php_max_children="$value"
        ;;
      *)
        echo "unknown configuration key in $filepath: $key" >&2
        return 1
        ;;
    esac
  done < "$filepath"
  return 0
}

if [[ $action == runtime ]]; then
  php_version=$4; memory_limit=$5; max_execution_time=$6; upload_max_filesize=$7; post_max_size=$8; max_input_vars=$9; opcache_enabled=${10}; display_errors=${11}; error_reporting=${12}
  error_pattern='^[A-Z0-9_~& |]{1,80}$'
  [[ $php_version =~ ^[0-9]+\.[0-9]+$ && $memory_limit =~ ^[1-9][0-9]{0,4}M$ && $max_execution_time =~ ^[1-9][0-9]{0,4}$ && $upload_max_filesize =~ ^[1-9][0-9]{0,4}M$ && $post_max_size =~ ^[1-9][0-9]{0,4}M$ && $max_input_vars =~ ^[1-9][0-9]{0,6}$ && $opcache_enabled =~ ^[01]$ && $display_errors =~ ^[01]$ && $error_reporting =~ $error_pattern ]] || { echo 'invalid PHP runtime profile' >&2; exit 1; }
  tmp=$(mktemp "$php_state/.runtime.XXXXXX")
  # Values have already passed strict allow-list validation, so write the
  # profile format directly. Shell-escaping with %q would persist backslashes
  # that parse_config_file intentionally does not interpret.
  printf 'php_version=%s\nmemory_limit=%s\nmax_execution_time=%s\nupload_max_filesize=%s\npost_max_size=%s\nmax_input_vars=%s\nopcache_enabled=%s\ndisplay_errors=%s\nerror_reporting=%s\n' "$php_version" "$memory_limit" "$max_execution_time" "$upload_max_filesize" "$post_max_size" "$max_input_vars" "$opcache_enabled" "$display_errors" "$error_reporting" > "$tmp"
  chown root:root "$tmp"; chmod 0600 "$tmp"; mv -f "$tmp" "$profile"
elif [[ $action == resources ]]; then
  workers=$4
  [[ $workers =~ ^[0-9]+$ ]] && (( workers >= 1 && workers <= 512 )) || { echo 'invalid PHP worker limit' >&2; exit 1; }
  tmp=$(mktemp "$php_state/.resources.XXXXXX")
  printf 'php_max_children=%q\n' "$workers" > "$tmp"; chown root:root "$tmp"; chmod 0600 "$tmp"; mv -f "$tmp" "$php_state/resources.env"
elif [[ $action == quota ]]; then
  disk_mb=$4; inodes=$5
  [[ $disk_mb =~ ^[0-9]+$ && $inodes =~ ^[0-9]+$ ]] || { echo 'invalid filesystem quota' >&2; exit 1; }
  (( disk_mb >= 64 && disk_mb <= 1048576 && inodes >= 1000 && inodes <= 1000000000 )) || { echo 'filesystem quota out of range' >&2; exit 1; }
  command -v setquota >/dev/null 2>&1 || { echo 'setquota is required and filesystem quotas are not available' >&2; exit 1; }
  command -v findmnt >/dev/null 2>&1 || { echo 'findmnt is required for filesystem quota detection' >&2; exit 1; }
  mount=$(findmnt -no TARGET -T "$site_root") || { echo 'could not determine site filesystem mount' >&2; exit 1; }
  options=$(findmnt -no OPTIONS -T "$site_root") || { echo 'could not inspect site filesystem quota options' >&2; exit 1; }
  [[ $options =~ (^|,)(usrquota|uquota|usrjquota)(=|,|$) ]] || { echo 'site filesystem is not mounted with user quotas enabled' >&2; exit 1; }
  blocks=$(( (disk_mb * 1024 * 1024 + 1023) / 1024 ))
  setquota -u "$site_user" "$blocks" "$blocks" "$inodes" "$inodes" "$mount"
  printf 'filesystem_quota_applied\tmount=%s\tdisk_mb=%s\tinodes=%s\n' "$mount" "$disk_mb" "$inodes"
  exit 0
elif [[ $action == quota-clear ]]; then
  command -v setquota >/dev/null 2>&1 || { echo 'setquota is required and filesystem quotas are not available' >&2; exit 1; }
  command -v findmnt >/dev/null 2>&1 || { echo 'findmnt is required for filesystem quota detection' >&2; exit 1; }
  mount=$(findmnt -no TARGET -T "$site_root") || { echo 'could not determine site filesystem mount' >&2; exit 1; }
  options=$(findmnt -no OPTIONS -T "$site_root") || { echo 'could not inspect site filesystem quota options' >&2; exit 1; }
  [[ $options =~ (^|,)(usrquota|uquota|usrjquota)(=|,|$) ]] || { echo 'site filesystem is not mounted with user quotas enabled' >&2; exit 1; }
  setquota -u "$site_user" 0 0 0 0 "$mount"
  printf 'filesystem_quota_cleared\tmount=%s\n' "$mount"
  exit 0
fi

php_max_children=5
parse_config_file "$profile" || { echo 'failed to parse PHP runtime configuration' >&2; exit 1; }
parse_config_file "$php_state/resources.env" || { echo 'failed to parse PHP resources configuration' >&2; exit 1; }

if [[ $action == seal && -d $site_root/public ]]; then
  # Only the document root is served. Runtime trees beside it, such as the
  # Python virtualenv, and node_modules (never served) legitimately use links.
  symlink=$(find -P "$site_root/public" -xdev -path "$site_root/public/node_modules" -prune -o -type l -print -quit)
  [[ -z $symlink ]] || { echo "site document root contains a symlink and cannot be sealed: $symlink" >&2; exit 1; }
fi
if [[ $action == seal ]]; then
  chown -R "$site_user:$web_group" "$site_root"
  find "$site_root" -type d -exec chmod 2750 {} +
fi

# Apply ACLs after any chmod: chmod on a directory with an ACL resets the ACL
# mask to the group bits (r-x here), which would silently remove the panel's
# write access and break release staging. setfacl -m recalculates the mask.
if [[ $action == prepare || $action == seal ]]; then
  command -v setfacl >/dev/null 2>&1 || { echo 'setfacl is required for site isolation' >&2; exit 1; }
  # ACLs are established when a tree is first staged/published. Their
  # directory defaults cover files and directories created later, so routine
  # runtime/resource changes do not rescan the whole site.
  setfacl -R -m u:stepanel:rwX "$site_root"
  # The site root itself is the parent used for atomic publication and
  # recovery renames. Keep its panel access explicit even when an ACL mask was
  # rewritten by a host-specific chmod implementation.
  setfacl -m u:stepanel:rwx "$site_root"
  find "$site_root" -type d -exec setfacl -m d:u:stepanel:rwx {} +
fi

pool_targets=()
pool_backups=()
pool_existed=()
pool_staged=()
validators=()
mapfile -t fpm_units < <(systemctl list-unit-files --type=service --no-legend 'php*-fpm.service' 'php-fpm.service' 2>/dev/null | awk '{print $1}')
(( ${#fpm_units[@]} > 0 )) || { echo 'PHP-FPM systemd unit was not found' >&2; exit 1; }

rollback_pools() {
  local index
  for (( index=${#pool_targets[@]}-1; index>=0; index-- )); do
    if [[ ${pool_existed[$index]} == 1 ]]; then
      mv -f "${pool_backups[$index]}" "${pool_targets[$index]}" || true
    else
      rm -f "${pool_targets[$index]}"
    fi
  done
}

cleanup_pool_temp() {
  local path
  for path in "${pool_backups[@]}" "${pool_staged[@]}"; do
    [[ -n $path ]] && rm -f "$path"
  done
}

pool_error() {
  local status=$?
  trap - ERR
  rollback_pools
  local unit
  for unit in "${fpm_units[@]}"; do systemctl reload-or-restart "$unit" 2>/dev/null || true; done
  cleanup_pool_temp
  exit "$status"
}
trap pool_error ERR

write_pool() {
  local target=$1 listen=$2 staged backup existed=0 opcache_flag=no display_errors_flag=no
  (( opcache_enabled == 1 )) && opcache_flag=yes
  (( display_errors == 1 )) && display_errors_flag=yes
  backup=$(mktemp)
  if [[ -e $target ]]; then cp -p "$target" "$backup"; existed=1; fi
  pool_targets+=("$target")
  pool_backups+=("$backup")
  pool_existed+=("$existed")
  staged=$(mktemp "${target}.XXXXXX")
  pool_staged+=("$staged")
  cat > "$staged" <<EOF
; Managed by StePanel. Manual changes will be replaced.
[stepanel-$site]
user = $site_user
group = $site_user
listen = $listen
listen.owner = $site_user
listen.group = $web_group
listen.mode = 0660
pm = ondemand
pm.max_children = $php_max_children
pm.process_idle_timeout = 10s
pm.max_requests = 500
chdir = /
catch_workers_output = yes
clear_env = yes
security.limit_extensions = .php
php_admin_value[open_basedir] = $public_root:$php_state
php_admin_value[session.save_path] = $php_state/sessions
php_admin_value[sys_temp_dir] = $php_state/tmp
php_admin_value[upload_tmp_dir] = $php_state/tmp
php_admin_value[memory_limit] = $memory_limit
php_admin_value[max_execution_time] = $max_execution_time
php_admin_value[upload_max_filesize] = $upload_max_filesize
php_admin_value[post_max_size] = $post_max_size
php_admin_value[max_input_vars] = $max_input_vars
php_admin_flag[opcache.enable] = $opcache_flag
php_admin_flag[display_errors] = $display_errors_flag
php_admin_value[error_reporting] = $error_reporting
EOF
  chmod 0644 "$staged"
  chown root:root "$staged"
  mv -f "$staged" "$target"
}

pool_written=0
for pool_root in /etc/php/*/fpm/pool.d; do
  [[ -d $pool_root ]] || continue
  version_root=$(dirname "$(dirname "$pool_root")")
  version=${version_root##*/}
  [[ -z $php_version || $version == "$php_version" ]] || continue
  validator=$(command -v "php-fpm$version") || { echo "php-fpm$version validator was not found" >&2; false; }
  validators+=("$validator")
  install -d -m 0755 "$socket_root"
  write_pool "$pool_root/stepanel-$site.conf" "$socket_root/stepanel-$site-$version.sock"
  pool_written=1
done
if [[ -d /etc/php-fpm.d ]]; then
  validator=$(command -v php-fpm) || { echo 'php-fpm validator was not found' >&2; false; }
  validators+=("$validator")
  install -d -m 0755 "$socket_root"
  write_pool "/etc/php-fpm.d/stepanel-$site.conf" "$socket_root/stepanel-$site.sock"
  pool_written=1
fi
if (( ! pool_written )); then
  echo 'PHP-FPM pool directory was not found' >&2
  exit 1
fi

for validator in "${validators[@]}"; do
  validator_output=$(mktemp)
  if ! "$validator" -tt >"$validator_output" 2>&1; then
    cat "$validator_output" >&2 || true
    rm -f "$validator_output"
    echo "$validator rejected the managed pool" >&2
    false
  fi
  rm -f "$validator_output"
done
for unit in "${fpm_units[@]}"; do systemctl reload-or-restart "$unit"; done
trap - ERR
cleanup_pool_temp

printf '%s\n' "$site_user"
