#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $EUID -ne 0 ]]; then echo 'must run as root' >&2; exit 1; fi
action=${1:-}

if [[ -d /etc/apache2 ]]; then
  config_root=/etc/apache2/stepanel-sites
  proxy_root=/etc/apache2/stepanel-proxy
  apache_service=apache2
  log_root='${APACHE_LOG_DIR}'
  socket_root=/run/php
elif [[ -d /etc/httpd ]]; then
  config_root=/etc/httpd/conf.d/stepanel-sites
  proxy_root=/etc/httpd/conf.d/stepanel-proxy
  apache_service=httpd
  log_root=/var/log/httpd
  socket_root=/run/php-fpm
else
  echo 'Apache configuration directory was not found' >&2
  exit 1
fi

install -d -m 0755 -o root -g root "$config_root" "$proxy_root"
command -v flock >/dev/null 2>&1 || { echo 'flock is required for Apache configuration locking' >&2; exit 1; }
exec 9>/run/lock/stepanel-apache.lock
flock -x 9

apache_test() {
  if command -v apachectl >/dev/null 2>&1; then apachectl -t
  else httpd -t
  fi
}
apache_reload() { systemctl reload "$apache_service"; }

domain_in_use() {
  local domain=$1 own=$2 candidate
  for candidate in "$config_root"/*.conf "$proxy_root"/*.conf /etc/apache2/sites-enabled/*.conf /etc/httpd/conf.d/*.conf; do
    [[ -f $candidate && $candidate != "$own" ]] || continue
    awk -v expected="$domain" 'tolower($1) == "servername" && tolower($2) == expected { found=1 } END { exit !found }' "$candidate" && return 0
  done
  return 1
}

case "$action" in
  apply|apply-auth)
    [[ ( $action == "apply-auth" && $# -eq 5 ) || ( $action == "apply" && $# -eq 3 ) ]] || { echo 'invalid vhost arguments' >&2; exit 64; }
    site=$2; domain=${3,,}
    auth_user=${4:-}; auth_hash=${5:-}
    bcrypt_pattern='^\$2[aby]\$[0-9]{2}\$[./A-Za-z0-9]{53}$'
    if [[ $action == apply-auth ]]; then [[ $auth_user =~ ^[A-Za-z0-9._-]{1,64}$ && $auth_hash =~ $bcrypt_pattern ]] || { echo 'invalid Basic Auth credentials' >&2; exit 1; }; fi
    [[ $site =~ ^[a-z0-9_-]{1,32}$ ]] || { echo 'invalid site' >&2; exit 1; }
    [[ $domain =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || { echo 'invalid domain' >&2; exit 1; }
    (( ${#site} + ${#domain} <= 220 )) || { echo 'site and domain combination is too long' >&2; exit 1; }
    public_root="/var/www/sites/$site/public"
    [[ -d $public_root && ! -L $public_root ]] || { echo 'site document root is unavailable or unsafe' >&2; exit 1; }
    name="site-${site}-${domain//./_}.conf"
    path="$config_root/$name"
    domain_in_use "$domain" "$path" && { echo 'domain is already assigned to another managed route' >&2; exit 1; }
    if [[ -d /etc/apache2 ]]; then
      pool=
      selected_version=
      profile="/var/www/sites/$site/.php/runtime.env"
      [[ ! -f $profile || -L $profile ]] || selected_version=$(awk -F= '$1 == "php_version" { gsub(/['"'"'\047]/, "", $2); print $2; exit }' "$profile")
      for candidate in /etc/php/*/fpm/pool.d/stepanel-"$site".conf; do
        [[ -f $candidate ]] || continue
        version_root=$(dirname "$(dirname "$(dirname "$candidate")")")
        candidate_version=${version_root##*/}
        [[ -z $selected_version || $candidate_version == "$selected_version" ]] || continue
        systemctl is-active --quiet "php$candidate_version-fpm.service" || continue
        pool=$candidate
        version=$candidate_version
        break
      done
      [[ -n $pool ]] || { echo 'an active isolated PHP-FPM pool was not found for this site' >&2; exit 1; }
      socket="$socket_root/stepanel-$site-$version.sock"
    else
      pool="/etc/php-fpm.d/stepanel-$site.conf"
      socket="$socket_root/stepanel-$site.sock"
      systemctl is-active --quiet php-fpm.service || { echo 'PHP-FPM is not active' >&2; exit 1; }
    fi
    [[ -f $pool ]] || { echo 'isolated PHP-FPM pool is not configured for this site' >&2; exit 1; }
    backup=$(mktemp)
    auth_file="$config_root/.stepanel-auth-$site"
    auth_backup=$(mktemp)
    auth_existed=0
    auth_staged=
    if [[ $action == apply-auth ]]; then
      [[ ! -f $auth_file ]] || { cp -p "$auth_file" "$auth_backup"; auth_existed=1; }
      auth_staged=$(mktemp "$config_root/.stepanel-auth.XXXXXX")
      printf '%s:%s\n' "$auth_user" "$auth_hash" > "$auth_staged"
      chmod 0600 "$auth_staged"
      chown root:root "$auth_staged"
      mv -f "$auth_staged" "$auth_file"
    fi
    existed=0
    [[ ! -f $path ]] || { cp -p "$path" "$backup"; existed=1; }
    staged=$(mktemp "$config_root/.stepanel-site.XXXXXX")
    trap 'rm -f "$backup" "$staged" "$auth_backup" "$auth_staged"' EXIT
    cat > "$staged" <<EOF
<VirtualHost *:80>
    ServerName $domain
    DocumentRoot $public_root
    DirectoryIndex index.php index.html
    <Directory "$public_root">
        Options SymLinksIfOwnerMatch
        AllowOverride FileInfo
        Require all granted
    </Directory>
    <FilesMatch "(?i)(^\\.|\\.(sql|sqlite3?|db|dump|log|bak|backup|old|orig|save|tar|tgz|zip|7z|rar|gz|bz2|xz|zst|enc|pem|key|p12|pfx)(\\..*)?$)">
        Require all denied
    </FilesMatch>
    <DirectoryMatch "(?i)^/var/www/sites/$site/public/(.*/)?(node_modules|\\.git|\\.svn|\\.hg|\\.ssh|\\.aws|\\.gnupg|backup|backups|private)(/|$)">
        Require all denied
    </DirectoryMatch>
    <FilesMatch "\\.php$">
        SetHandler "proxy:unix:$socket|fcgi://localhost/"
    </FilesMatch>
    ProxyFCGIBackendType FPM
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
$(if [[ -f "/var/www/sites/$site/.stepanel-staging-noindex" && ! -L "/var/www/sites/$site/.stepanel-staging-noindex" ]]; then printf '    Header always set X-Robots-Tag "noindex, nofollow"\n'; fi)
$(if [[ $action == apply-auth ]]; then printf '    <Location />\n        AuthType Basic\n        AuthName "StePanel staging"\n        AuthBasicProvider file\n        AuthUserFile %s\n        Require valid-user\n    </Location>\n' "$auth_file"; fi)
    ErrorLog $log_root/stepanel-$site-error.log
    CustomLog $log_root/stepanel-$site-access.log combined
</VirtualHost>
EOF
    chmod 0644 "$staged"
    chown root:root "$staged"
    mv -f "$staged" "$path"
    if ! apache_test; then
      if (( existed )); then mv -f "$backup" "$path"; else rm -f "$path"; fi
      if [[ $action == apply-auth ]]; then if (( auth_existed )); then mv -f "$auth_backup" "$auth_file"; else rm -f "$auth_file"; fi; fi
      exit 1
    fi
    if ! apache_reload; then
      if (( existed )); then mv -f "$backup" "$path"; else rm -f "$path"; fi
      if [[ $action == apply-auth ]]; then if (( auth_existed )); then mv -f "$auth_backup" "$auth_file"; else rm -f "$auth_file"; fi; fi
      if apache_test; then apache_reload || true; fi
      exit 1
    fi
    if [[ $action == apply ]]; then rm -f "$auth_file"; fi
    ;;
  delete)
    (( $# == 2 )) || { echo 'usage: stepanel-vhostctl delete NAME' >&2; exit 64; }
    name=$2
    [[ $name =~ ^site-[a-z0-9_-]{1,32}-[a-z0-9_-]+\.conf$ ]] || { echo 'invalid site route name' >&2; exit 1; }
    path="$config_root/$name"
    [[ ! -L $path ]] || { echo 'site route is unsafe' >&2; exit 1; }
    if [[ ! -e $path ]]; then
      # A previous delete may have removed the config before the journal
      # recorded completion. Validate and reload on replay so Apache's active
      # vhost set converges before the cleanup is acknowledged.
      apache_test || { echo 'Apache configuration is invalid after route deletion' >&2; exit 1; }
      apache_reload || { echo 'could not reload Apache after route deletion' >&2; exit 1; }
      exit 0
    fi
    [[ -f $path ]] || { echo 'site route is not a regular file' >&2; exit 1; }
    domain=$(awk 'tolower($1) == "servername" { print tolower($2); exit }' "$path")
    [[ $domain =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || { echo 'managed route has an invalid ServerName' >&2; exit 1; }
    domain_in_use "$domain" "$path" && { echo 'another Apache vhost still serves this domain; remove its TLS or external vhost first' >&2; exit 1; }
    backup=$(mktemp)
    trap 'rm -f "$backup"' EXIT
    cp -p "$path" "$backup"
    rm -f "$path"
    if ! apache_test; then mv -f "$backup" "$path"; exit 1; fi
    if ! apache_reload; then mv -f "$backup" "$path"; if apache_test; then apache_reload || true; fi; exit 1; fi
    ;;
  *) echo 'usage: stepanel-vhostctl apply SITE DOMAIN | delete NAME' >&2; exit 64 ;;
esac
