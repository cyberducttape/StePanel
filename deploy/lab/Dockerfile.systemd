ARG BASE_IMAGE
FROM ${BASE_IMAGE}

RUN if command -v dnf >/dev/null 2>&1; then \
      dnf -y install systemd openssh-server openssh-clients strace && \
      dnf clean all && rm -rf /var/cache/dnf; \
    elif command -v apt-get >/dev/null 2>&1; then \
      apt-get update && apt-get install -y systemd systemd-sysv openssh-server openssh-client strace && \
      rm -rf /var/lib/apt/lists/*; \
    else \
      echo 'unsupported base image: neither dnf nor apt-get is available' >&2; exit 1; \
    fi

# Some overlay-backed privileged containers lack an effective DAC override
# when reading a mode-000 shadow file. Keep the test fixture root-only but
# readable by the PAM helper running as root. Native-host certification retains
# the distribution's original shadow permissions.
RUN chmod 0600 /etc/shadow

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
