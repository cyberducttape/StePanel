[Unit]
Description=StePanel disposable lab root broker
After=local-fs.target mariadb.service postgresql.service

[Service]
Type=simple
User=root
Group=stepanel
Environment=STEPANEL_LAB_ROOT_BROKER_HELPERS=1
ExecStart=/usr/local/sbin/stepanel-root -webroot /var/www -control-plane-db /var/lib/ste-panel/stepanel-control.db -socket /run/stepanel-root-broker.sock -socket-group stepanel
Restart=on-failure
RestartSec=1s
UMask=0007
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
RestrictNamespaces=true
ReadWritePaths=/etc /etc/.pwd.lock /etc/.grp.lock /etc/.shadow.lock /etc/.gshadow.lock /run /tmp /var/backups /var/lib /var/www /var/log
