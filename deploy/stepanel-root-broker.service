[Unit]
Description=StePanel root-owned host mutation broker
After=local-fs.target network.target
Before=stepanel.service stepanel-worker.service

[Service]
Type=simple
User=root
Group=stepanel
# Keep the broker isolated from the panel's secret-bearing environment file.
# The native installer uses this same authoritative recovery root in
# STEPANEL_RECOVERY_ROOT.
ExecStart=/usr/local/sbin/stepanel-root -webroot /var/www -recovery-root /var/www/sites/.stepanel-recovery -control-plane-db /var/lib/ste-panel/stepanel-control.db -socket /run/stepanel-root-broker.sock -socket-group stepanel
Restart=on-failure
RestartSec=1s
TimeoutStopSec=2h5min
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native
# Account-management tools update /etc/passwd and friends by creating an
# atomic sibling (for example /etc/passwd.<pid>) before renaming it. The
# broker is the only root service that needs this host mutation surface; the
# validated helpers still enforce narrower operation-specific paths.
ProtectSystem=strict
# The root broker needs the account database and systemd unit directories
# under /etc, while all other host writes are confined to managed state,
# site data, and the selected webserver/certbot logs. Certbot uses its own
# state/cache/log directories under /var/lib, /var/cache, and /var/log.
ReadWritePaths=/etc /run /tmp -/usr/local/lsws /var/backups/stepanel /var/lib/stepanel /var/lib/stepanel-privileged -/var/lib/letsencrypt -/var/cache/letsencrypt -/var/lib/ste-panel -/var/www -/var/log/apache2 -/var/log/httpd -/var/log/letsencrypt

[Install]
WantedBy=multi-user.target
