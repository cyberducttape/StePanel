[Unit]
Description=StePanel durable job worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stepanel
Group=stepanel
WorkingDirectory=/opt/stepanel
EnvironmentFile=/etc/ste-panel.env
Environment=STEPANEL_DB_PASSWORD_FILE=/etc/stepanel-db.password
ExecStart=/opt/stepanel/stepanel worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=2h5min
UMask=0027
LimitNOFILE=65536
TasksMax=512
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native
ProtectSystem=full
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
