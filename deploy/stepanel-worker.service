[Unit]
Description=StePanel durable job worker
After=network-online.target stepanel.service
Wants=network-online.target

[Service]
Type=simple
User=stepanel
Group=stepanel
WorkingDirectory=/opt/stepanel
EnvironmentFile=/etc/ste-panel.env
Environment=STEPANEL_DB_PASSWORD_FILE=/etc/stepanel-db.password
ExecStart=/opt/stepanel/stepanel worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=2h5min
UMask=0027
LimitNOFILE=65536
TasksMax=512
AmbientCapabilities=
NoNewPrivileges=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native
# The service runs as an unprivileged user and reaches root only through the
# broker socket, so it needs no capabilities, namespaces, SysV IPC, or
# privileged system calls; this also binds every helper it spawns.
CapabilityBoundingSet=
RestrictNamespaces=true
PrivateIPC=true
RemoveIPC=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
PrivateTmp=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
ReadWritePaths=/var/lib/ste-panel /var/www/sites /var/backups/stepanel

[Install]
WantedBy=multi-user.target
