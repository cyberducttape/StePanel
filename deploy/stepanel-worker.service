[Unit]
Description=StePanel durable job worker
After=network-online.target stepanel.service
Wants=network-online.target

[Service]
Type=simple
User=stepanel
Group=stepanel
WorkingDirectory=/opt/stepanel
EnvironmentFile=/etc/ste-panel.env
Environment=STEPANEL_DB_PASSWORD_FILE=/etc/stepanel-db.password
ExecStart=/opt/stepanel/stepanel worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=2h5min
UMask=0027
LimitNOFILE=65536
TasksMax=512
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
RestrictNamespaces=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/ste-panel /var/backups/stepanel /var/www/sites -/var/lib/stepanel-privileged -/etc/systemd/system -/etc/letsencrypt -/etc/apache2 -/etc/httpd -/etc/caddy -/usr/local/lsws/conf/vhosts/stepanel -/etc/php -/etc/php-fpm.d -/var/lib/letsencrypt -/var/log/letsencrypt -/run/sudo

[Install]
WantedBy=multi-user.target
