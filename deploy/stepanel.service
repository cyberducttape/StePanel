[Unit]
Description=StePanel infrastructure control plane
After=network-online.target
Wants=network-online.target stepanel-worker.service

[Service]
Type=simple
User=stepanel
Group=stepanel
WorkingDirectory=/opt/stepanel
EnvironmentFile=/etc/ste-panel.env
Environment=STEPANEL_DB_PASSWORD_FILE=/etc/stepanel-db.password
ExecStart=/opt/stepanel/stepanel
Restart=on-failure
RestartSec=5s
TimeoutStopSec=2h5min
UMask=0027
LimitNOFILE=65536
TasksMax=512
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native
# Keep OS binaries and kernel interfaces immutable from the daemon while
# leaving /etc writable to the narrowly scoped privileged helpers. NoNewPrivileges
# and SUID restrictions are intentionally not enabled: production helper calls
# use the installer's exact-command sudoers boundary.
ProtectSystem=full
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictRealtime=true
# The daemon is unprivileged. Its sudoers policy permits only the validated
# root helpers; filesystem access is constrained by normal ownership and ACLs.

[Install]
WantedBy=multi-user.target
